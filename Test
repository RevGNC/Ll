            end)
        else
            if sectionName and sectionName ~= "" then
                local HeaderRow = CreateElement("Frame", {
                    Name = "HeaderRow",
                    Parent = SectionFrame,
                    Size = SafeUDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    ZIndex = 3,
                })

                local SectionIndicator = CreateElement("Frame", {
                    Name = "SectionIndicator",
                    Parent = HeaderRow,
                    Size = SafeUDim2.new(0, 3, 0, 12),
                    Position = SafeUDim2.new(0, 0, 0.5, 0),
                    AnchorPoint = SafeVector2.new(0, 0.5),
                    BackgroundColor3 = Config.Colors.Accent,
                    BorderSizePixel = 0,
                    ZIndex = 4,
                })
                CreateElement("UICorner", {
                    CornerRadius = SafeUDim.new(0, 2),
                    Parent = SectionIndicator
                })

                local SectionLabel = CreateElement("TextLabel", {
                    Name = "SectionLabel",
                    Parent = HeaderRow,
                    Size = SafeUDim2.new(1, -30, 1, 0),
                    Position = SafeUDim2.new(0, 9, 0, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Font = SafeEnum.Font.GothamBold,
                    Text = sectionName,
                    TextColor3 = Config.Colors.Text,
                    TextSize = titleTextSize or 13.5,
                    TextXAlignment = SafeEnum.TextXAlignment.Left,
                    TextYAlignment = SafeEnum.TextYAlignment.Center,
                    TextWrapped = true,
                    TextTruncate = SafeEnum.TextTruncate and SafeEnum.TextTruncate.AtEnd or "AtEnd",
                    RichText = true,
                    ZIndex = 4,
                })

                local LockIcon = CreateElement("ImageLabel", {
                    Name = "LockIcon",
                    Parent = HeaderRow,
                    Size = SafeUDim2.new(0, 14, 0, 14),
                    AnchorPoint = SafeVector2.new(1, 0.5),
                    Position = SafeUDim2.new(1, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Image = "rbxassetid://72426107706105",
                    ImageColor3 = Config.Colors.TextMuted,
                    ZIndex = 4,
                })
            end

            if description and description ~= "" then
                CreateElement("TextLabel", {
                    Name = "DescriptionLabel",
                    Parent = SectionFrame,
                    Size = SafeUDim2.new(1, 0, 0, 0),
                    AutomaticSize = SafeEnum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Font = SafeEnum.Font.Gotham,
                    Text = description,
                    TextColor3 = Config.Colors.TextSecondary,
                    TextSize = 11.5,
                    TextXAlignment = SafeEnum.TextXAlignment.Left,
                    TextWrapped = true,
                    RichText = true,
                    ZIndex = 4,
                })
            end
        end

        local SectionContainer = CreateElement("Frame", {
            Name = "SectionContainer",
            Parent = SectionFrame,
            Size = SafeUDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 3,
        })

        local sectionLayout = CreateElement("UIListLayout", {
            Parent = SectionContainer,
            Padding = SafeUDim.new(0, 8),
            SortOrder = SafeEnum.SortOrder.LayoutOrder
        })

        CreateElement("UIPadding", {
            Parent = SectionContainer,
            PaddingBottom = SafeUDim.new(0, 2),
            PaddingLeft = SafeUDim.new(0, 2),
            PaddingRight = SafeUDim.new(0, 2),
            PaddingTop = SafeUDim.new(0, 4)
        })

        local function getCalculatedHeight()
            if not sectionLayout then return 0 end
            local contentHeight = sectionLayout.AbsoluteContentSize and sectionLayout.AbsoluteContentSize.Y or 0
            if contentHeight <= 0 and SectionContainer and SectionContainer.GetChildren then
                local sum = 0
                for _, child in ipairs(SectionContainer:GetChildren()) do
                    if child:IsA("GuiObject") and child.Visible ~= false then
                        local h = (child.Size and child.Size.Y and child.Size.Y.Offset) or 0
                        if h <= 0 and child.AbsoluteSize and child.AbsoluteSize.Y > 0 then
                            h = child.AbsoluteSize.Y
                        end
                        if h <= 0 then
                            local name = tostring(child.Name or "")
                            if string.find(name, "_Paragraph") then
                                h = 50
                            elseif string.find(name, "_Dropdown") then
                                h = 42
                            elseif string.find(name, "_Textbox") or string.find(name, "_Input") then
                                h = 48
                            elseif string.find(name, "TagContainer") then
                                h = 32
                            else
                                h = 40
                            end
                        end
                        sum = sum + h + 8
                    end
                end
                if sum > 0 then
                    contentHeight = sum
                end
            end
            return contentHeight > 0 and (contentHeight + 8) or 0
        end

        local function updateSectionSize()
            if sectionLayout then
                if isExpanded then
                    local h = getCalculatedHeight()
                    SectionContainer.Size = SafeUDim2.new(1, 0, 0, h)
                else
                    SectionContainer.Size = SafeUDim2.new(1, 0, 0, 0)
                end
            end
        end

        local task_defer = (task and task.defer) or (task and task.spawn) or spawn

        if isExpanded then
            task_defer(function()
                updateSectionSize()
            end)
        end

        if SectionContainer.ChildAdded and type(SectionContainer.ChildAdded.Connect) == "function" then
            SectionContainer.ChildAdded:Connect(function()
                task.delay(0.05, function()
                    if isExpanded then
                        updateSectionSize()
                        if updatePageCanvasSize then updatePageCanvasSize() end
                    end
                end)
            end)
        end

        if SectionContainer.ChildRemoved and type(SectionContainer.ChildRemoved.Connect) == "function" then
            SectionContainer.ChildRemoved:Connect(function()
                task.delay(0.05, function()
                    if isExpanded then
                        updateSectionSize()
                        if updatePageCanvasSize then updatePageCanvasSize() end
                    end
                end)
            end)
        end

        local function toggleSection()
            isExpanded = not isExpanded

            local targetHeight = isExpanded and getCalculatedHeight() or 0
            local targetSize = SafeUDim2.new(1, 0, 0, targetHeight)
            
            TweenService:Create(SectionContainer, TweenInfo.new(0.2, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.Out), {
                Size = targetSize
            }):Play()

            if chevronIcon then
                TweenService:Create(chevronIcon, TweenInfo.new(0.2, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.Out), {
                    Rotation = isExpanded and 180 or 0
                }):Play()
            end

            task.delay(0.22, function()
                if updatePageCanvasSize then updatePageCanvasSize() end
            end)
        end

        if chevronIcon and isExpanded then
            chevronIcon.Rotation = 180
        end

        if not isLocked and topBox then
            topBox.MouseButton1Click:Connect(toggleSection)
            if chevronIcon and chevronIcon.MouseButton1Click then
                chevronIcon.MouseButton1Click:Connect(toggleSection)
            end
        end

        if sectionLayout then
            sectionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                if isExpanded then
                    local newHeight = getCalculatedHeight()
                    if newHeight > 0 then
                        TweenService:Create(SectionContainer, TweenInfo.new(0.15, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.Out), {
                            Size = SafeUDim2.new(1, 0, 0, newHeight)
                        }):Play()
                    end
                    task.delay(0.16, function()
                        if updatePageCanvasSize then updatePageCanvasSize() end
                    end)
                end
            end)
        end

        if isLocked then
            Section.Container = SectionFrame
        else
            Section.Container = SectionContainer
        end

        function Section:Toggle()
            if not isLocked then
                toggleSection()
            end
            return isExpanded
        end

        function Section:IsExpanded()
            return isExpanded
        end

        function Section:GetCalculatedHeight()
            return getCalculatedHeight()
        end

        -- Component Proxies
        function Section:AddToggle(toggleName, defaultState, callback)
            return ToggleMod.AddToggle(Section, Window, CreateElement, Config, SafeW, TweenService)(toggleName, defaultState, callback)
        end

        function Section:AddButton(buttonName, callback, variant, iconId)
            return ButtonMod.AddButton(Section, CreateElement, Config, TweenService)(buttonName, callback, variant, iconId)
        end

        function Section:AddIconsButton(buttonName, callback, iconId)
            return ButtonMod.AddIconsButton(Section, CreateElement, Config, TweenService)(buttonName, callback, iconId)
        end

        function Section:AddParagraph(ConfigTable, description)
            return ParagraphMod.AddParagraph(Section, CreateElement, Config)(ConfigTable, description)
        end

        function Section:AddTag(TagConfig, secondaryColor)
            return ParagraphMod.AddTag(Section, CreateElement, Config, TweenService, deps.ResolveColor)(TagConfig, secondaryColor)
        end

        function Section:AddTextbox(textboxName, placeholder, defaultValue, textDisappear, callback)
            return TextboxMod.AddTextbox(Section, Window, CreateElement, Config, TweenService)(textboxName, placeholder, defaultValue, textDisappear, callback)
        end

        function Section:AddInput(inputName, placeholder, defaultValue, callback)
            return TextboxMod.AddInput(Section, Window, CreateElement, Config, TweenService)(inputName, placeholder, defaultValue, callback)
        end

        function Section:AddDropdown(dropdownConfig, options, default, callback)
            return DropdownMod.AddDropdown(Section, Window, CreateElement, Config, TweenService, updatePageCanvasSize)(dropdownConfig, options, default, callback)
        end

        function Section:AddSlider(sliderConfig, minVal, maxVal, defaultVal, callback)
            return SliderMod.AddSlider(Section, Window, CreateElement, Config, SafeW, TweenService, UserInputService)(sliderConfig, minVal, maxVal, defaultVal, callback)
        end

        return Section
    end
end

return { SetupAddSection = SetupAddSection }

end)

return __REQUIRE("GNCHUB")
