            for optName, btn in pairs(Dropdown.Buttons) do
                local textLabel = btn:FindFirstChild("OptionLabel")
                if textLabel then
                    local btnText = string.lower(textLabel.Text)
                    local match = (searchText == "") or (string.find(btnText, searchText, 1, true) ~= nil)
                    btn.Visible = match
                    if match then
                        matchCount = matchCount + 1
                    end
                end
            end

            emptyLabel.Visible = (matchCount == 0)
            dropcont.CanvasPosition = Vector2.new(0, 0)
            updateDropdownLayout(true)
        end

        SearchInput:GetPropertyChangedSignal("Text"):Connect(SearchOptions)

        SearchInput.Focused:Connect(function()
