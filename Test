__DEF("GNCHUB.components.slider", function()
-- File: GNCHUB/components/slider.lua
--[[
    GNCHUB Modular Library
    Modul  : Slider Component (Reworked - Tactile & Direct Input)
    Layer  : 4
    Require: utils/elements, core/config, core/safe_wrappers
    Ekspor : AddSlider
--]]

local function AddSlider(Section, Window, CreateElement, Config, SafeW, TweenService, UserInputService)
    local SafeEnum    = SafeW.SafeEnum
    local SafeUDim2   = SafeW.SafeUDim2
    local SafeUDim    = SafeW.SafeUDim
    local SafeColor3  = SafeW.SafeColor3
    local SafeVector2 = SafeW.SafeVector2

    return function(sliderConfig, minVal, maxVal, defaultVal, callback)
        local config = {}
        if type(sliderConfig) == "table" then
            config = sliderConfig
            config.Title = config.Title or config.Name or "Slider"
            config.Description = config.Description or nil
            config.Min = config.Min or 0
            config.Max = config.Max or 100
            config.Default = config.Default or config.Min
            config.Increment = config.Increment or config.Step or 1
            config.Suffix = config.Suffix or ""
            config.Callback = config.Callback or function() end
        else
            config.Title = sliderConfig or "Slider"
            config.Min = minVal or 0
            config.Max = maxVal or 100
            config.Default = defaultVal or config.Min
            config.Increment = 1
            config.Suffix = ""
            config.Callback = callback or function() end
        end

        if config.Min > config.Max then
            config.Min, config.Max = config.Max, config.Min
        end
        if not config.Increment or config.Increment <= 0 then
            config.Increment = 1
        end

        local function Round(Number, Factor)
            if not Factor or Factor <= 0 then
                return Number
            end
            local Result = math.floor(Number / Factor + 0.5) * Factor
            local factorStr = tostring(Factor)
            local dotIndex = string.find(factorStr, "%.")
            if dotIndex then
                local decimalPlaces = string.len(factorStr) - dotIndex
                if decimalPlaces > 0 then
                    Result = tonumber(string.format("%." .. decimalPlaces .. "f", Result)) or Result
                end
            end
            return Result
        end

        local Slider = {
            Value = config.Default,
            Min = config.Min,
            Max = config.Max,
            Increment = config.Increment,
            Callback = config.Callback,
            Type = "Slider",
            FirstUpdate = true
        }

        local Dragging = false
        local currentDragInput = nil
        local dragInputEndedConn = nil

        local frameHeight = config.Description and 66 or 52

        local SliderFrame = CreateElement("Frame", {
            Name = config.Title .. "_Slider",
            Parent = Section.Container,
            Size = SafeUDim2.new(1, 0, 0, frameHeight),
            BackgroundColor3 = Config.Colors.Primary,
            BorderSizePixel = 0,
            ZIndex = 4,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(0, Config.ControlRadius or 7),
            Parent = SliderFrame
        })

        local SliderStroke = CreateElement("UIStroke", {
            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
            Color = Config.Colors.Stroke,
            Thickness = 1,
            Transparency = 0.45,
            Parent = SliderFrame
        })

        local ContentContainer = CreateElement("Frame", {
            Name = "Content",
            Parent = SliderFrame,
            Size = SafeUDim2.new(1, -24, 1, 0),
            Position = SafeUDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            ZIndex = 4,
        })

        -- Title & Description
        local SliderLabel = CreateElement("TextLabel", {
            Name = "Label",
            Parent = ContentContainer,
            Size = SafeUDim2.new(0.68, 0, 0, 18),
            Position = SafeUDim2.new(0, 0, 0, 8),
            BackgroundTransparency = 1,
            Font = SafeEnum.Font.GothamSemibold,
            Text = config.Title,
            TextColor3 = Config.Colors.Text,
            TextSize = 13,
            TextXAlignment = SafeEnum.TextXAlignment.Left,
            TextYAlignment = SafeEnum.TextYAlignment.Center,
            TextTruncate = SafeEnum.TextTruncate and SafeEnum.TextTruncate.AtEnd or "AtEnd",
            ZIndex = 5,
        })

        if config.Description then
            CreateElement("TextLabel", {
                Name = "Description",
                Parent = ContentContainer,
                Size = SafeUDim2.new(0.68, 0, 0, 15),
                Position = SafeUDim2.new(0, 0, 0, 26),
                BackgroundTransparency = 1,
                Font = SafeEnum.Font.Gotham,
                Text = config.Description,
                TextColor3 = Config.Colors.TextSecondary,
                TextSize = 11.5,
                TextXAlignment = SafeEnum.TextXAlignment.Left,
                TextYAlignment = SafeEnum.TextYAlignment.Top,
                TextWrapped = true,
                ZIndex = 5,
            })
        end

        -- Editable Value Input Box
        local ValueBoxFrame = CreateElement("Frame", {
            Name = "ValueBoxFrame",
            Parent = ContentContainer,
            AnchorPoint = SafeVector2.new(1, 0),
            Position = SafeUDim2.new(1, 0, 0, 7),
            Size = SafeUDim2.new(0, 64, 0, 22),
            BackgroundColor3 = Config.Colors.Input,
            BorderSizePixel = 0,
            ZIndex = 5,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(0, 5),
            Parent = ValueBoxFrame
        })

        local ValueBoxStroke = CreateElement("UIStroke", {
            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
            Color = Config.Colors.Stroke,
            Thickness = 1,
            Transparency = 0.45,
            Parent = ValueBoxFrame
        })

        local ValueInput = CreateElement("TextBox", {
            Name = "ValueInput",
            Parent = ValueBoxFrame,
            Size = SafeUDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Font = SafeEnum.Font.GothamBold,
            Text = tostring(config.Default) .. config.Suffix,
            TextColor3 = Config.Colors.Text,
            TextSize = 11,
            TextXAlignment = SafeEnum.TextXAlignment.Center,
            TextYAlignment = SafeEnum.TextYAlignment.Center,
            ClearTextOnFocus = false,
            ZIndex = 6,
        })

        local sliderYPos = config.Description and 48 or 35

        -- Slider Track Groove
        local SliderBar = CreateElement("Frame", {
            Name = "SliderBar",
            Parent = ContentContainer,
            Size = SafeUDim2.new(1, 0, 0, 6),
            Position = SafeUDim2.new(0, 0, 0, sliderYPos),
            BackgroundColor3 = Config.Colors.Secondary,
            BorderSizePixel = 0,
            ZIndex = 5,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(0, 3),
            Parent = SliderBar
        })

        -- Active Progress Fill
        local SliderProgress = CreateElement("Frame", {
            Name = "SliderProgress",
            Parent = SliderBar,
            Size = SafeUDim2.new(0, 0, 1, 0),
            Position = SafeUDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Config.Colors.Accent,
            BorderSizePixel = 0,
            ZIndex = 6,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(0, 3),
            Parent = SliderProgress
        })

        -- Sliding Thumb Knob
        local SliderDot = CreateElement("Frame", {
            Name = "SliderDot",
            Parent = SliderBar,
            Size = SafeUDim2.new(0, 14, 0, 14),
            Position = SafeUDim2.new(0, 0, 0.5, 0),
            AnchorPoint = SafeVector2.new(0.5, 0.5),
            BackgroundColor3 = Config.Colors.Text,
            BorderSizePixel = 0,
            ZIndex = 10,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(1, 0),
            Parent = SliderDot
        })

        local DotStroke = CreateElement("UIStroke", {
            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
            Color = Config.Colors.StrokeLight,
            Thickness = 1.5,
            Transparency = 0.25,
            Parent = SliderDot
        })

        -- Invisible Overlay for Clicking & Dragging Track
        local SliderClickArea = CreateElement("TextButton", {
            Name = "SliderClickArea",
            Parent = ContentContainer,
            Size = SafeUDim2.new(1, 0, 0, 20),
            Position = SafeUDim2.new(0, 0, 0, sliderYPos - 7),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 8,
        })

        local tweenFast = TweenInfo.new(0.15, SafeEnum.EasingStyle.Quad, SafeEnum.EasingDirection.Out)

        local function SetSliderVal(Value, ignore)
            local numVal = tonumber(Value) or config.Min
            if numVal ~= numVal then
                numVal = config.Min
            end
            Slider.Value = math.clamp(Round(numVal, config.Increment), config.Min, config.Max)

            local displayValue = tostring(Slider.Value)
            ValueInput.Text = displayValue .. config.Suffix

            local range = config.Max - config.Min
            local newPosition = (range == 0) and 0 or math.clamp((Slider.Value - config.Min) / range, 0, 1)

            local targetSize = SafeUDim2.new(newPosition, 0, 1, 0)
            local targetDotPos = SafeUDim2.new(newPosition, 0, 0.5, 0)

            if Dragging or Slider.FirstUpdate then
                SliderProgress.Size = targetSize
                SliderDot.Position = targetDotPos
            else
                TweenService:Create(SliderProgress, tweenFast, { Size = targetSize }):Play()
                TweenService:Create(SliderDot, tweenFast, { Position = targetDotPos }):Play()
            end

            if not ignore and (not Slider.FirstUpdate) then
                task.spawn(function()
                    pcall(Slider.Callback, Slider.Value)
                end)
            end
            Slider.FirstUpdate = false
        end

        function Slider:Set(valOrIgnore, maybeIgnore)
            if type(self) ~= "table" or self ~= Slider then
                SetSliderVal(self, valOrIgnore)
            else
                SetSliderVal(valOrIgnore, maybeIgnore)
            end
        end

        function Slider:GetValue()
            return Slider.Value
        end
        Slider.Get = Slider.GetValue

        function Slider:SetValue(val, ignore)
            return self:Set(val, ignore)
        end

        -- Direct Input Handler
        ValueInput.Focused:Connect(function()
            TweenService:Create(ValueBoxStroke, tweenFast, {
                Color = Config.Colors.Accent,
                Transparency = 0.1
            }):Play()
            ValueInput.Text = tostring(Slider.Value)
        end)

        ValueInput.FocusLost:Connect(function(enterPressed)
            TweenService:Create(ValueBoxStroke, tweenFast, {
                Color = Config.Colors.StrokeLight,
                Transparency = 0.5
            }):Play()

            local parsed = tonumber(ValueInput.Text)
            if parsed then
                Slider:Set(parsed)
            else
                Slider:Set(Slider.Value)
            end
        end)

        local function updateSliderFromInput(inputPosition)
            if not Dragging then return end
            local barPosition = SliderBar.AbsolutePosition
            local barSize = SliderBar.AbsoluteSize
            if barSize.X > 0 then
                local relativeX = (inputPosition.X - barPosition.X) / barSize.X
                local clampedPosition = math.clamp(relativeX, 0, 1)
                local newValue = config.Min + (config.Max - config.Min) * clampedPosition
                Slider:Set(newValue)
            end
        end

        local function endDrag()
            if not Dragging then return end
            Dragging = false
            currentDragInput = nil

            if dragInputEndedConn then
                dragInputEndedConn:Disconnect()
                dragInputEndedConn = nil
            end

            TweenService:Create(SliderFrame, tweenFast, {
                BackgroundColor3 = Config.Colors.Primary
            }):Play()
            TweenService:Create(SliderDot, tweenFast, {
                Size = SafeUDim2.new(0, 14, 0, 14)
            }):Play()
        end

        local function startDrag(input)
            if input.UserInputType == SafeEnum.UserInputType.MouseButton1 or input.UserInputType == SafeEnum.UserInputType.Touch then
                Dragging = true
                currentDragInput = input

                TweenService:Create(SliderFrame, tweenFast, {
                    BackgroundColor3 = Config.Colors.PrimaryLight
                }):Play()
                TweenService:Create(SliderDot, tweenFast, {
                    Size = SafeUDim2.new(0, 16, 0, 16)
                }):Play()

                updateSliderFromInput(input.Position)

                if dragInputEndedConn then
                    dragInputEndedConn:Disconnect()
                    dragInputEndedConn = nil
                end

                dragInputEndedConn = input.Changed:Connect(function()
                    local state = input.UserInputState
                    if state == SafeEnum.UserInputState.End or state == SafeEnum.UserInputState.Cancel then
                        endDrag()
                    end
                end)
            end
        end

        SliderClickArea.InputBegan:Connect(startDrag)
        SliderBar.InputBegan:Connect(startDrag)

        if UserInputService then
            UserInputService.InputEnded:Connect(function(input)
                if Dragging then
                    if input == currentDragInput or input.UserInputType == SafeEnum.UserInputType.MouseButton1 or input.UserInputType == SafeEnum.UserInputType.Touch then
                        endDrag()
                    end
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Dragging then
                    if input == currentDragInput or (currentDragInput and currentDragInput.UserInputType == SafeEnum.UserInputType.MouseButton1 and input.UserInputType == SafeEnum.UserInputType.MouseMovement) then
                        updateSliderFromInput(input.Position)
                    end
                end
            end)
        end

        SliderClickArea.MouseEnter:Connect(function()
            if not Dragging then
                TweenService:Create(SliderFrame, tweenFast, { BackgroundColor3 = Config.Colors.PrimaryLight }):Play()
                TweenService:Create(SliderStroke, tweenFast, { Transparency = 0.2 }):Play()
                TweenService:Create(SliderDot, tweenFast, { Size = SafeUDim2.new(0, 16, 0, 16) }):Play()
            end
        end)

        SliderClickArea.MouseLeave:Connect(function()
            if not Dragging then
                TweenService:Create(SliderFrame, tweenFast, { BackgroundColor3 = Config.Colors.Primary }):Play()
                TweenService:Create(SliderStroke, tweenFast, { Transparency = 0.5 }):Play()
                TweenService:Create(SliderDot, tweenFast, { Size = SafeUDim2.new(0, 14, 0, 14) }):Play()
            end
        end)

        Slider:Set(config.Default, true)

        Window:RegisterConfigElement(Section.TabName, Section.SectionName, config.Title, Slider)

        return Slider
    end
end

return { AddSlider = AddSlider }

end)

