local function makeSafeEnumSub(target)
    return setmetatable(target or {}, {
        __index = function(_, k)
            return k
        end
    })
end

local SafeEnum = setmetatable({}, {
    __index = function(t, enumName)
        if Enum then
            local ok, val = pcall(function() return Enum[enumName] end)
            if ok and val ~= nil then
                rawset(t, enumName, val)
                return val
            end
        end
        local fallback = makeSafeEnumSub()
        rawset(t, enumName, fallback)
        return fallback
    end
})

