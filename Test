                closeTween:Play()
                shadowClose:Play()
                closeTween.Completed:Connect(function()
                    MainFrame.Visible = false
                    ShadowFrame.Visible = false
                    ContentContainer.Visible = false
                    if toggleBtn then
                        toggleBtn.Visible = true
                    end
                    isAnimating = false
                end)
            end
        end

