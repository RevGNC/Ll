        return { R = r or 0, G = g or 0, B = b or 0 }
    end
}

local SafeUDim2 = UDim2 or {
    new = function(xScale, xOffset, yScale, yOffset)
        return {
            X = {Scale = xScale or 0, Offset = xOffset or 0},
