            TextXAlignment = SafeEnum.TextXAlignment and SafeEnum.TextXAlignment.Left or "Left",
            TextYAlignment = SafeEnum.TextYAlignment and SafeEnum.TextYAlignment.Top or "Top",
            AutomaticSize = SafeEnum.AutomaticSize and SafeEnum.AutomaticSize.XY or "XY",
            LayoutOrder = 1,
            BackgroundTransparency = 1,
            Text = message,
            Visible = true,
            ZIndex = 203
        })

        local ProgressFrame = CreateElement("Frame", {
            Name = "ProgressFrame",
            Parent = NotificationFrame,
            AnchorPoint = SafeVector2.new(0.5, 1),
            BackgroundTransparency = 1,
            Position = SafeUDim2.new(0.5, 0, 1, 0),
            Size = SafeUDim2.new(1, 0, 0, 2),
            Visible = true,
            ZIndex = 202
        })

