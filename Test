local function AnimateIn(element, animationType)
    animationType = animationType or "fade"

    if animationType == "fade" then
        element.BackgroundTransparency = 1
        local tween = TweenService:Create(element, TweenInfo.new(
            Config.Effects.AnimationTime,
            Config.Effects.EasingStyle,
            Config.Effects.EasingDirection
        ), { BackgroundTransparency = 0 })
        tween:Play()
    elseif animationType == "scale" then
        local targetSize = element.Size
        element.AnchorPoint = SafeVector2.new(0.5, 0.5)
        element.Position = SafeUDim2.new(
            element.Position.X.Scale + targetSize.X.Scale/2,
            element.Position.X.Offset + targetSize.X.Offset/2,
            element.Position.Y.Scale + targetSize.Y.Scale/2,
            element.Position.Y.Offset + targetSize.Y.Offset/2
        )
        element.Size = SafeUDim2.new(0, 0, 0, 0)
        local tween = TweenService:Create(element, TweenInfo.new(
            Config.Effects.AnimationTime,
            SafeEnum.EasingStyle.Back,
            SafeEnum.EasingDirection.Out
        ), { Size = targetSize })
        tween:Play()
    end
end

return {
    CreateGradient = CreateGradient,
    CreateGlow     = CreateGlow,
    AnimateIn      = AnimateIn,
}

end)

__DEF("GNCHUB.utils.draggable", function()
-- File: GNCHUB/utils/draggable.lua
--[[
    GNCHUB Modular Library
    Modul  : Draggable
    Layer  : 2
    Require: core/safe_wrappers
    Ekspor : { MakeDraggable, CleanupConnections, GlobalInputConnections }
--]]

local SafeW   = __REQUIRE("GNCHUB.core.safe_wrappers")
local SafeEnum    = SafeW.SafeEnum
local SafeUDim2   = SafeW.SafeUDim2

-- Shared state (dipakai bersama dengan scroll.lua via init.lua)
local GlobalInputConnections = {}

-- Referensi ke ScrollConnections dari scroll module (di-set oleh init.lua)
local _ScrollConnections = nil

local function SetScrollConnections(sc)
    _ScrollConnections = sc
end

local UserInputService = game and game.GetService and game:GetService("UserInputService") or nil

local function MakeDraggable(element, target)
    local dragging = false
    local dragStart, startPos
    local targetFrame = target or ((element.Parent and pcall(function() return element.Parent.Position end) and element.Parent.Position) and element.Parent or element)
    local dragMoved = false

    local function updatePosition(inputPos)
        if dragging and startPos and dragStart then
            local delta = inputPos - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
                dragMoved = true
            end
            targetFrame.Position = SafeUDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end

    element.InputBegan:Connect(function(input)
        if input.UserInputType == SafeEnum.UserInputType.MouseButton1 or input.UserInputType == SafeEnum.UserInputType.Touch then
            dragging = true
            dragMoved = false
            dragStart = input.Position
            startPos = targetFrame.Position

            local changedConn
            changedConn = input.Changed:Connect(function()
                local state = input.UserInputState
                if state == SafeEnum.UserInputState.End or state == SafeEnum.UserInputState.Cancel then
                    dragging = false
                    if changedConn then
                        changedConn:Disconnect()
                        changedConn = nil
                    end
                end
            end)
        end
    end)

    element.InputEnded:Connect(function(input)
        if input.UserInputType == SafeEnum.UserInputType.MouseButton1 or input.UserInputType == SafeEnum.UserInputType.Touch then
            dragging = false
        end
    end)

    element.InputChanged:Connect(function(input)
        if (input.UserInputType == SafeEnum.UserInputType.MouseMovement or input.UserInputType == SafeEnum.UserInputType.Touch) and dragging then
            updatePosition(input.Position)
        end
    end)

    if UserInputService then
        local uisChangedConn = UserInputService.InputChanged:Connect(function(input)
            if (input.UserInputType == SafeEnum.UserInputType.MouseMovement or input.UserInputType == SafeEnum.UserInputType.Touch) and dragging then
                updatePosition(input.Position)
            end
        end)
        table.insert(GlobalInputConnections, uisChangedConn)

        local uisEndConn = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == SafeEnum.UserInputType.MouseButton1 or input.UserInputType == SafeEnum.UserInputType.Touch then
                dragging = false
            end
        end)
        table.insert(GlobalInputConnections, uisEndConn)
    end

    return function()
        return dragMoved
    end
end

local function CleanupConnections(scrollConnections)
    scrollConnections = scrollConnections or _ScrollConnections or {}

    for scrollFrame, connectionData in pairs(scrollConnections) do
        if type(connectionData) == "table" then

            for _, connection in pairs(connectionData) do
                if connection and connection.Connected then
                    connection:Disconnect()
                end
            end
        elseif connectionData and connectionData.Connected then

            connectionData:Disconnect()
        end
    end
    -- Clear the table in-place
    for k in pairs(scrollConnections) do
        scrollConnections[k] = nil
    end

    for _, connection in pairs(GlobalInputConnections) do
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
    for k in pairs(GlobalInputConnections) do
        GlobalInputConnections[k] = nil
    end
end

return {
    MakeDraggable          = MakeDraggable,
    CleanupConnections     = CleanupConnections,
    SetScrollConnections   = SetScrollConnections,
    GlobalInputConnections = GlobalInputConnections,
}

end)

__DEF("GNCHUB.utils.elements", function()
-- File: GNCHUB/utils/elements.lua
--[[
    GNCHUB Modular Library
    Modul  : Elements
    Layer  : 1
    Require: core/safe_wrappers
    Ekspor : CreateElement
--]]

local function CreateElement(className, properties)
    local element
    local success = false

    if Instance and Instance.new then
        success, element = pcall(function()
            return Instance.new(className)
        end)
    end

    if not success or not element then
        local guiObjectClasses = {
            Frame = true,
            TextLabel = true,
            TextButton = true,
            ImageLabel = true,
            ImageButton = true,
            ScrollingFrame = true,
            TextBox = true,
            CanvasGroup = true,
            ViewportFrame = true,
            VideoFrame = true,
        }

        local children = {}
        local childAddedCallbacks = {}
        local childRemovedCallbacks = {}
        local propSignals = {}

        element = {
            Name = className,
            ClassName = className,
            Visible = true,
            ZIndex = 1,
            _children = children,
        }

        local fireChildAdded = function(c)
            for _, fn in ipairs(childAddedCallbacks) do
                pcall(fn, c)
            end
        end
        local fireChildRemoved = function(c)
            for _, fn in ipairs(childRemovedCallbacks) do
                pcall(fn, c)
            end
        end
        element._fireChildAdded = fireChildAdded
        element._fireChildRemoved = fireChildRemoved

        setmetatable(element, {
            __index = function(t, k)
                if k == "ZIndex" then
                    return rawget(t, k) or 1
                end

                if k == "GetChildren" then
                    return function()
                        local copy = {}
                        for i, c in ipairs(children) do copy[i] = c end
                        return copy
                    end
                end

                if k == "GetDescendants" then
                    return function()
                        local desc = {}
                        local function collect(curr)
                            if curr._children then
                                for _, c in ipairs(curr._children) do
                                    table.insert(desc, c)
                                    collect(c)
                                end
                            end
                        end
                        collect(t)
                        return desc
                    end
                end

                if k == "IsA" then
                    return function(_, c)
                        if c == className or c == "Instance" then return true end
                        if c == "GuiObject" then return guiObjectClasses[className] == true end
                        if c == "UIComponent" or c == "UIGridStyleLayout" then
                            return className == "UIListLayout" or className == "UIPadding" or className == "UICorner" or className == "UIStroke"
                        end
                        return false
                    end
                end

                if k == "FindFirstChild" or k == "WaitForChild" then
                    return function(_, name)
                        for _, c in ipairs(children) do
                            if c.Name == name then return c end
                        end
                        return nil
                    end
                end

                if k == "Destroy" or k == "ClearAllChildren" then
                    return function()
                        for i = #children, 1, -1 do
                            local c = children[i]
                            table.remove(children, i)
                            if c then rawset(c, "Parent", nil) end
                        end
                    end
                end

                if k == "ChildAdded" then
                    return {
                        Connect = function(_, fn)
                            table.insert(childAddedCallbacks, fn)
                            return {
                                Connected = true,
                                Disconnect = function()
                                    for i, f in ipairs(childAddedCallbacks) do
                                        if f == fn then table.remove(childAddedCallbacks, i) break end
                                    end
                                end
                            }
                        end
                    }
                end

                if k == "ChildRemoved" then
                    return {
                        Connect = function(_, fn)
                            table.insert(childRemovedCallbacks, fn)
                            return {
                                Connected = true,
                                Disconnect = function()
                                    for i, f in ipairs(childRemovedCallbacks) do
                                        if f == fn then table.remove(childRemovedCallbacks, i) break end
                                    end
                                end
                            }
                        end
                    }
                end

                if k == "GetPropertyChangedSignal" then
                    return function(_, propName)
                        if not propSignals[propName] then propSignals[propName] = {} end
                        return {
                            Connect = function(_, fn)
                                table.insert(propSignals[propName], fn)
                                return {
                                    Connected = true,
                                    Disconnect = function()
                                        for i, f in ipairs(propSignals[propName]) do
                                            if f == fn then table.remove(propSignals[propName], i) break end
                                        end
                                    end
                                }
                            end
                        }
                    end
                end

                if k == "Connect" then
                    return function()
                        return {
                            Connected = true,
                            Disconnect = function() end
                        }
                    end
                end

                if k == "InputBegan" or k == "InputEnded" or k == "InputChanged" or k == "Changed" or
                   k == "MouseEnter" or k == "MouseLeave" or k == "MouseButton1Down" or k == "MouseButton1Up" or
                   k == "MouseButton1Click" or k == "FocusLost" or k == "Focused" or k == "Destroying" or
                   k == "Completed" or k == "DescendantAdded" or k == "DescendantRemoving" then
                    return {
                        Connect = function()
                            return {
                                Connected = true,
                                Disconnect = function() end
                            }
                        end
                    }
                end

                return rawget(t, k)
            end,
            __newindex = function(t, k, v)
                if k == "Parent" then
                    local oldParent = rawget(t, "Parent")
                    if oldParent and oldParent._children then
                        for idx, c in ipairs(oldParent._children) do
                            if c == t then
                                table.remove(oldParent._children, idx)
                                if oldParent._fireChildRemoved then
                                    oldParent._fireChildRemoved(t)
                                end
                                break
                            end
                        end
                    end
                    rawset(t, "Parent", v)
                    if v and v._children then
                        table.insert(v._children, t)
                        if v._fireChildAdded then
                            v._fireChildAdded(t)
                        end
                    end
                    return
                end
                rawset(t, k, v)
                if propSignals[k] then
                    for _, fn in ipairs(propSignals[k]) do
                        pcall(fn, v)
                    end
                end
            end
        })

        if warn then warn("Using fallback element for:", className) end
    end

    local pendingParent = nil
    for prop, value in pairs(properties or {}) do
        if prop == "Parent" then
            pendingParent = value
        else
            local propSuccess, propError = pcall(function()
                element[prop] = value
            end)
            if not propSuccess then
                if warn then warn("Failed to set property", prop, "on", className, ":", propError) end
            end
        end
    end

    if className == "ScreenGui" then
        pcall(function()
            if Enum and Enum.ZIndexBehavior and Enum.ZIndexBehavior.Sibling then
                element.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            end
        end)
    end

    if pendingParent ~= nil then
        local parentSuccess, parentError = pcall(function()
            element.Parent = pendingParent
        end)
        if not parentSuccess then
            if warn then warn("Failed to set Parent on", className, ":", parentError) end
        end
    end

    return element
end

return CreateElement

end)

__DEF("GNCHUB.utils.esp", function()
-- File: GNCHUB/utils/esp.lua
-- GNCHUB ESP Library

local SafeColor3 = Color3 or {
    fromRGB = function(r, g, b) return { R = (r or 0)/255, G = (g or 0)/255, B = (b or 0)/255 } end,
    new = function(r, g, b) return { R = r or 0, G = g or 0, B = b or 0 } end
}

local ESP = {
    Enabled = false,
    Boxes = false,
    BoxOutline = true,
    BoxColor = SafeColor3.fromRGB(255, 255, 255),
    Names = false,
    NameColor = SafeColor3.fromRGB(255, 255, 255),
    Health = false,
    Distance = false,
    Tracers = false,
    TracerColor = SafeColor3.fromRGB(255, 255, 255),
    TracerOrigin = "Bottom", -- "Top", "Center", "Bottom", "Mouse"
    TeamCheck = false,
    MaxDistance = 3000,
    TextSize = 14,
    Players = {},
    Connections = {}
}

local Players = game and game.GetService and game:GetService("Players") or nil
local RunService = game and game.GetService and game:GetService("RunService") or nil

local function getCamera()
    if workspace and workspace.CurrentCamera then
        return workspace.CurrentCamera
    end
    local ws = game and game.GetService and game:GetService("Workspace")
    return ws and ws.CurrentCamera or nil
end

local function CreateDummyDrawing()
    local dummy = {
        Visible = false,
        Color = Color3.new(1, 1, 1),
        Thickness = 1,
        Transparency = 1,
        Filled = false,
        Center = false,
        Outline = false,
        Font = 2,
        Size = 14,
        Position = Vector2.new(0, 0),
        From = Vector2.new(0, 0),
        To = Vector2.new(0, 0),
        Text = "",
        Remove = function() end,
        Destroy = function() end
    }
    return dummy
end

local function DrawLine()
    if not Drawing or not Drawing.new then return CreateDummyDrawing() end
    local ok, line = pcall(function() return Drawing.new("Line") end)
    if ok and line then
        line.Visible = false
        line.Color = Color3.new(1, 1, 1)
        line.Thickness = 1
        line.Transparency = 1
        return line
    end
    return CreateDummyDrawing()
end

local function DrawText()
    if not Drawing or not Drawing.new then return CreateDummyDrawing() end
    local ok, text = pcall(function() return Drawing.new("Text") end)
    if ok and text then
        text.Visible = false
        text.Center = true
        text.Outline = true
        text.Font = 2
        text.Size = 14
        text.Color = Color3.new(1, 1, 1)
        return text
    end
    return CreateDummyDrawing()
end

local function DrawSquare()
    if not Drawing or not Drawing.new then return CreateDummyDrawing() end
    local ok, square = pcall(function() return Drawing.new("Square") end)
    if ok and square then
        square.Visible = false
        square.Color = Color3.new(1, 1, 1)
        square.Thickness = 1
        square.Transparency = 1
        square.Filled = false
        return square
    end
    return CreateDummyDrawing()
end

function ESP:AddPlayer(player)
    local LocalPlayer = Players and Players.LocalPlayer
    if player == LocalPlayer then return end
    
    local objects = {
        -- Outlines first so they render behind
        TopLineO = DrawLine(),
        BottomLineO = DrawLine(),
        LeftLineO = DrawLine(),
        RightLineO = DrawLine(),
        HealthBarOutline = DrawLine(),
        
        -- Inner lines render on top
        TopLine = DrawLine(),
        BottomLine = DrawLine(),
        LeftLine = DrawLine(),
        RightLine = DrawLine(),
        HealthBar = DrawLine(),
        
        Tracer = DrawLine(),
        Name = DrawText(),
        Distance = DrawText(),
    }
    
    local outlineThickness = 3
    local innerThickness = 1.5
    local outlineColor = Color3.new(0, 0, 0)
    
    objects.TopLineO.Thickness = outlineThickness
    objects.TopLineO.Color = outlineColor
    objects.BottomLineO.Thickness = outlineThickness
    objects.BottomLineO.Color = outlineColor
    objects.LeftLineO.Thickness = outlineThickness
    objects.LeftLineO.Color = outlineColor
    objects.RightLineO.Thickness = outlineThickness
    objects.RightLineO.Color = outlineColor
    
    objects.TopLine.Thickness = innerThickness
    objects.BottomLine.Thickness = innerThickness
    objects.LeftLine.Thickness = innerThickness
    objects.RightLine.Thickness = innerThickness
    
    objects.HealthBarOutline.Thickness = 5
    objects.HealthBarOutline.Color = outlineColor
    
    objects.HealthBar.Thickness = 3
    
    self.Players[player] = objects
end

function ESP:RemovePlayer(player)
    if self.Players[player] then
        for _, obj in pairs(self.Players[player]) do
            obj:Remove()
        end
        self.Players[player] = nil
    end
end

function ESP:Toggle(state)
    self.Enabled = state
    if not state then
        for player, objects in pairs(self.Players) do
            for _, obj in pairs(objects) do
                obj.Visible = false
            end
        end
    end
end

function ESP:Update()
    if not self.Enabled then return end

    local Camera = getCamera()
    if not Camera then return end

    local LocalPlayer = Players and Players.LocalPlayer

    for player, objects in pairs(self.Players) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChild("Humanoid")
        local head = character and character:FindFirstChild("Head")
        
        local isAlive = humanoid and humanoid.Health > 0
        local isAlly = self.TeamCheck and LocalPlayer and player.Team == LocalPlayer.Team
        
        local distance = rootPart and math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude) or 0
        local isTooFar = distance > self.MaxDistance
        
        if isAlive and rootPart and head and not isAlly and not isTooFar then
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
            
            if onScreen then
                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 2
                
                -- Box
                if self.Boxes then
                    local TL = Vector2.new(rootPos.X - width/2, rootPos.Y - height/2)
                    local TR = Vector2.new(rootPos.X + width/2, rootPos.Y - height/2)
                    local BL = Vector2.new(rootPos.X - width/2, rootPos.Y + height/2)
                    local BR = Vector2.new(rootPos.X + width/2, rootPos.Y + height/2)
                    
                    objects.TopLine.From = TL
                    objects.TopLine.To = TR
                    objects.TopLine.Color = self.BoxColor
                    objects.TopLine.Visible = true

                    objects.BottomLine.From = BL
                    objects.BottomLine.To = BR
                    objects.BottomLine.Color = self.BoxColor
                    objects.BottomLine.Visible = true

                    objects.LeftLine.From = TL
                    objects.LeftLine.To = BL
                    objects.LeftLine.Color = self.BoxColor
                    objects.LeftLine.Visible = true

                    objects.RightLine.From = TR
                    objects.RightLine.To = BR
                    objects.RightLine.Color = self.BoxColor
                    objects.RightLine.Visible = true
                    
                    if self.BoxOutline then
                        -- Outlines
                        objects.TopLineO.From = TL
                        objects.TopLineO.To = TR
                        objects.TopLineO.Visible = true
                        
                        objects.BottomLineO.From = BL
                        objects.BottomLineO.To = BR
                        objects.BottomLineO.Visible = true
                        
                        objects.LeftLineO.From = TL
                        objects.LeftLineO.To = BL
                        objects.LeftLineO.Visible = true
                        
                        objects.RightLineO.From = TR
                        objects.RightLineO.To = BR
                        objects.RightLineO.Visible = true
                    else
                        objects.TopLineO.Visible = false
                        objects.BottomLineO.Visible = false
                        objects.LeftLineO.Visible = false
                        objects.RightLineO.Visible = false
                    end
                else
                    objects.TopLine.Visible = false
                    objects.BottomLine.Visible = false
                    objects.LeftLine.Visible = false
                    objects.RightLine.Visible = false
                    
                    objects.TopLineO.Visible = false
                    objects.BottomLineO.Visible = false
                    objects.LeftLineO.Visible = false
                    objects.RightLineO.Visible = false
                end
                
                -- Health
                if self.Health then
                    local maxHealth = humanoid.MaxHealth
                    local healthPct = (maxHealth and maxHealth > 0) and math.clamp(humanoid.Health / maxHealth, 0, 1) or 0
                    local healthColor = Color3.new(1 - healthPct, healthPct, 0) -- Green to Red
                    
                    local barHeight = height * healthPct
                    local offsetX = width / 2 + 5 -- Distance from box

                    -- Outline (Black background)
                    objects.HealthBarOutline.From = Vector2.new(rootPos.X - offsetX, rootPos.Y + height/2 + 1)
                    objects.HealthBarOutline.To = Vector2.new(rootPos.X - offsetX, rootPos.Y - height/2 - 1)
                    objects.HealthBarOutline.Visible = true
                    
                    -- Actual Health Bar
                    objects.HealthBar.From = Vector2.new(rootPos.X - offsetX, rootPos.Y + height/2)
                    objects.HealthBar.To = Vector2.new(rootPos.X - offsetX, rootPos.Y + height/2 - barHeight)
                    objects.HealthBar.Color = healthColor
                    objects.HealthBar.Visible = true
                else
                    objects.HealthBar.Visible = false
                    objects.HealthBarOutline.Visible = false
                end
                
                -- Name
                if self.Names then
                    objects.Name.Text = player.Name
                    objects.Name.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 15)
                    objects.Name.Color = self.NameColor
                    objects.Name.Size = self.TextSize
                    objects.Name.Visible = true
                else
                    objects.Name.Visible = false
                end
                
                -- Distance
                if self.Distance then
                    local distance = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
                    objects.Distance.Text = tostring(distance) .. "m"
                    objects.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + height/2 + 2)
                    objects.Distance.Color = Color3.new(1, 1, 1)
                    objects.Distance.Size = self.TextSize
                    objects.Distance.Visible = true
                else
                    objects.Distance.Visible = false
                end
                
                -- Tracers
                if self.Tracers then
                    local viewportSize = Camera.ViewportSize or Vector2.new(1920, 1080)
                    local origin = Vector2.new(viewportSize.X/2, viewportSize.Y) -- Bottom
                    if self.TracerOrigin == "Top" then
                        origin = Vector2.new(viewportSize.X/2, 0)
                    elseif self.TracerOrigin == "Center" then
                        origin = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
                    elseif self.TracerOrigin == "Mouse" then
                        local mouse = LocalPlayer and LocalPlayer:GetMouse()
                        if mouse then
                            origin = Vector2.new(mouse.X, mouse.Y + 36) -- Offset for cursor
                        end
                    end
                    
                    objects.Tracer.From = origin
                    objects.Tracer.To = Vector2.new(rootPos.X, rootPos.Y - height/2) -- Top of box
                    objects.Tracer.Color = self.TracerColor
                    objects.Tracer.Visible = true
                else
                    objects.Tracer.Visible = false
                end
                
            else
                for _, obj in pairs(objects) do
                    obj.Visible = false
                end
            end
        else
            for _, obj in pairs(objects) do
                obj.Visible = false
            end
        end
    end
end

function ESP:Init()
    if self._Initialized then return end
    self._Initialized = true

    if not Players or not Players.GetPlayers or not RunService or not RunService.RenderStepped then return end

    for _, player in pairs(Players:GetPlayers()) do
        self:AddPlayer(player)
    end
    
    self.Connections.PlayerAdded = Players.PlayerAdded:Connect(function(player)
        self:AddPlayer(player)
    end)
    
    self.Connections.PlayerRemoving = Players.PlayerRemoving:Connect(function(player)
        self:RemovePlayer(player)
    end)
    
    self.Connections.RenderStepped = RunService.RenderStepped:Connect(function()
        self:Update()
    end)
end

function ESP:Unload()
    self._Initialized = false
    for _, conn in pairs(self.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    self.Connections = {}
    
    for player, _ in pairs(self.Players) do
        self:RemovePlayer(player)
    end
end

return ESP

end)

__DEF("GNCHUB.window.window", function()
-- File: GNCHUB/window/window.lua
--[[
    GNCHUB Modular Library
    Modul  : Window
    Layer  : 3
    Require: utils/elements, core/config, core/safe_wrappers, utils/draggable, utils/scroll
    Ekspor : SetupCreateWindow(Library, deps)
--]]

local function SetupCreateWindow(Library, deps)
    local CreateElement       = deps.CreateElement
    local Config              = deps.Config
    local SafeW               = deps.SafeW
    local TweenService        = deps.TweenService
    local UserInputService    = deps.UserInputService
    local RunService          = deps.RunService
    local ScrollToElement     = deps.ScrollToElement
    local MakeDraggable       = deps.MakeDraggable
    local ScrollConnections   = deps.ScrollConnections
    local GlobalInputConnections = deps.GlobalInputConnections
    local SetupMomentumScrolling = deps.SetupMomentumScrolling
    local SetupKeyboardNavigation = deps.SetupKeyboardNavigation
    local CreateEnhancedScrollFrame = deps.CreateEnhancedScrollFrame
    local SmoothScrollTo     = deps.SmoothScrollTo
    local CleanupConnections = deps.CleanupConnections
    local ResolveColor       = deps.ResolveColor

    local SafeEnum                  = SafeW.SafeEnum
    local SafeUDim2                 = SafeW.SafeUDim2
    local SafeUDim                  = SafeW.SafeUDim
    local SafeColor3                = SafeW.SafeColor3
    local SafeVector2               = SafeW.SafeVector2
    local SafeRect                  = SafeW.SafeRect
    local SafeColorSequence         = SafeW.SafeColorSequence or ColorSequence
    local SafeColorSequenceKeypoint = SafeW.SafeColorSequenceKeypoint or ColorSequenceKeypoint
    local TweenInfo                 = SafeW.SafeTweenInfo or TweenInfo

    function Library:CreateWindow(config)
        local Window = {}
        local Tabs = {}
        local CurrentTab = nil
        local isMinimized = false
        
        local ConfigElements = {}
        
        local function GetGameInfo()
            local gameName = "Unknown"
            local placeId = "0"
            
            pcall(function()
                placeId = tostring(game.PlaceId)
            end)
            
            pcall(function()
                local marketplaceService = game:GetService("MarketplaceService")
                local info = marketplaceService:GetProductInfo(game.PlaceId)
                if info and info.Name then
                    gameName = info.Name:gsub("[^%w%s%-_]", ""):gsub("%s+", "_"):sub(1, 50)
                end
            end)
            
            if gameName == "Unknown" or gameName == "" then
                pcall(function()
                    gameName = game:GetService("Players").LocalPlayer:GetAttribute("GameName") or "Game_" .. placeId
                end)
            end
            
            if gameName == "Unknown" or gameName == "" then
                gameName = "Game_" .. placeId
            end
            
            return gameName, placeId
        end
        
        local GameName, GamePlaceId = GetGameInfo()
        local BaseConfigFolder = "GNCHUB_Configs"
        local ConfigFolder = BaseConfigFolder .. "/" .. GameName .. "_" .. GamePlaceId
        local AutoLoadConfigFile = ConfigFolder .. "/autoload.txt"
        
        local function EnsureConfigFolders()
            if makefolder and isfolder then
                if not isfolder(BaseConfigFolder) then
                    makefolder(BaseConfigFolder)
                end
                if not isfolder(ConfigFolder) then
                    makefolder(ConfigFolder)
                end
            end
        end
        
        EnsureConfigFolders()

        local title, description, size, tagText, tagColor, toggleButton
        if type(config) == "string" then
            title = config
            description = ""
            size = SafeUDim2.new(0, 580, 0, 380)
            tagText = "v5.14.7"
            tagColor = ResolveColor(Config.Colors.Accent)
            toggleButton = ""
        elseif type(config) == "table" then
            title = config.Title or config.title or "GNCHUB Window"
            description = config.Description or config.description or ""
            size = config.Size or config.size or SafeUDim2.new(0, 580, 0, 380)
            tagText = config.TagText or config.tagText or "v5.14.7"
            tagColor = ResolveColor(config.TagColor or config.tagColor or Config.Colors.Accent)
            toggleButton = config.ToggleButton or config.toggleButton or ""
        else
            title = "GNCHUB Window"
            description = ""
            size = SafeUDim2.new(0, 580, 0, 380)
            tagText = "v5.14.7"
            tagColor = ResolveColor(Config.Colors.Accent)
        end

        pcall(function()
            local cam = workspace and workspace.CurrentCamera
            local viewport = cam and cam.ViewportSize
            if viewport and viewport.X > 0 and viewport.Y > 0 then
                local maxX = math.max(280, viewport.X - 24)
                local maxY = math.max(200, viewport.Y - 24)
                local curX = size.X.Offset
                local curY = size.Y.Offset
                if curX > maxX or curY > maxY then
                    size = SafeUDim2.new(size.X.Scale, math.min(curX, maxX), size.Y.Scale, math.min(curY, maxY))
                end
            end
        end)

        local parent = nil

        local okHui, hui = pcall(function() return gethui and gethui() end)
        if okHui and hui then
            parent = hui
        else
            local okCore, core = pcall(function()
                return game and game.GetService and game:GetService("CoreGui")
            end)
            if okCore and core then
                parent = core
            else
                local playersService = nil
                pcall(function()
                    if game and game.GetService then
                        playersService = game:GetService("Players")
                    end
