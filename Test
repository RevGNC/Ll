    local SafeColor3  = SafeW.SafeColor3
    local SafeVector2 = SafeW.SafeVector2

    local Tabs = Window.Tabs
    local CurrentTab = nil
    local PageContainer = Window.PageContainer
    local TabContainer = Window.TabContainer
