                    Size = SafeUDim2.new(size.X.Scale, size.X.Offset + 16, size.Y.Scale, size.Y.Offset + 16),
                    BackgroundTransparency = 0.7
                })
                openTween:Play()
                shadowOpen:Play()
                openTween.Completed:Connect(function()
                    isAnimating = false
                end)
            else
                lastPosition = MainFrame.Position
                local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.2, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.In), {
                    Size = SafeUDim2.new(0, size.X.Offset * 0.85, 0, 0)
