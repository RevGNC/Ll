        wait = function() end,
        spawn = function(fn, ...) if fn then fn(...) end end,
        delay = function(sec, fn, ...) if fn then fn(...) end end,
        defer = function(fn, ...) if fn then fn(...) end end,
    }
end

if not warn then
    _G.warn = function(...)
        -- Safe warn fallback for non-Roblox runtimes
    end
end

if not UDim2 then _G.UDim2 = SafeUDim2 end
if not UDim then _G.UDim = SafeUDim end
if not Vector2 then _G.Vector2 = SafeVector2 end
if not Color3 then _G.Color3 = SafeColor3 end
if not Rect then _G.Rect = SafeRect end
if not Enum then _G.Enum = SafeEnum end
if not Instance then
    local guiObjectClasses = {
        Frame = true,
        TextLabel = true,
        TextButton = true,
        ImageLabel = true,
        ImageButton = true,
        ScrollingFrame = true,
        TextBox = true,
        CanvasGroup = true,
        ViewportFrame = true,
        VideoFrame = true,
    }

    _G.Instance = {
        new = function(className)
            local children = {}
            local childAddedCallbacks = {}
            local childRemovedCallbacks = {}
            local propSignals = {}

            local elem = {
                Name = className,
                ClassName = className,
                Visible = true,
                ZIndex = 1,
                _children = children,
            }

            local fireChildAdded = function(c)
                for _, fn in ipairs(childAddedCallbacks) do
                    pcall(fn, c)
                end
            end
            local fireChildRemoved = function(c)
                for _, fn in ipairs(childRemovedCallbacks) do
                    pcall(fn, c)
                end
            end
            elem._fireChildAdded = fireChildAdded
            elem._fireChildRemoved = fireChildRemoved

            return setmetatable(elem, {
                __index = function(t, k)
                    if k == "GetChildren" then
                        return function()
                            local copy = {}
                            for i, c in ipairs(children) do copy[i] = c end
                            return copy
                        end
                    end
                    if k == "GetDescendants" then
                        return function()
                            local desc = {}
                            local function collect(curr)
                                if curr._children then
                                    for _, c in ipairs(curr._children) do
                                        table.insert(desc, c)
                                        collect(c)
                                    end
                                end
                            end
                            collect(t)
                            return desc
                        end
                    end
                    if k == "IsA" then
                        return function(_, c)
                            if c == className or c == "Instance" then return true end
                            if c == "GuiObject" then return guiObjectClasses[className] == true end
                            if c == "UIComponent" or c == "UIGridStyleLayout" then
                                return className == "UIListLayout" or className == "UIPadding" or className == "UICorner" or className == "UIStroke"
                            end
                            return false
                        end
                    end
                    if k == "FindFirstChild" or k == "WaitForChild" then
                        return function(_, name)
                            for _, c in ipairs(children) do
                                if c.Name == name then return c end
                            end
                            return nil
                        end
                    end
                    if k == "Destroy" or k == "ClearAllChildren" then
                        return function()
                            for i = #children, 1, -1 do
                                local c = children[i]
                                table.remove(children, i)
                                if c then rawset(c, "Parent", nil) end
                            end
                        end
                    end
                    if k == "ChildAdded" then
                        return {
                            Connect = function(_, fn)
                                table.insert(childAddedCallbacks, fn)
                                return {
                                    Connected = true,
                                    Disconnect = function()
                                        for i, f in ipairs(childAddedCallbacks) do
                                            if f == fn then table.remove(childAddedCallbacks, i) break end
                                        end
                                    end
                                }
                            end
                        }
                    end
                    if k == "ChildRemoved" then
                        return {
                            Connect = function(_, fn)
                                table.insert(childRemovedCallbacks, fn)
                                return {
                                    Connected = true,
                                    Disconnect = function()
                                        for i, f in ipairs(childRemovedCallbacks) do
                                            if f == fn then table.remove(childRemovedCallbacks, i) break end
                                        end
                                    end
                                }
                            end
                        }
                    end
                    if k == "GetPropertyChangedSignal" then
                        return function(_, propName)
                            if not propSignals[propName] then propSignals[propName] = {} end
                            return {
                                Connect = function(_, fn)
                                    table.insert(propSignals[propName], fn)
                                    return {
                                        Connected = true,
                                        Disconnect = function()
                                            for i, f in ipairs(propSignals[propName]) do
                                                if f == fn then table.remove(propSignals[propName], i) break end
                                            end
