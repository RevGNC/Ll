                    if not Dropdown.Toggled then
                        dropcontWrapper.Visible = false
                        SearchInput.Text = ""
                        dropcont.CanvasPosition = Vector2.new(0, 0)
                    end
                end)
            end

            task_defer(function()
                task.wait(0.2)
                if updatePageCanvasSize then updatePageCanvasSize() end
            end)
        end

        TriggerBox.MouseButton1Click:Connect(function()
            setDropdownOpen(not Dropdown.Toggled)
