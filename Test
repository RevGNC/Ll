        local savedData = LoadKeyData()
        if savedData and savedData.key and tostring(savedData.key) ~= "" then
            local cleanKey = tostring(savedData.key):match("^%s*(.-)%s*$")
            if cleanKey and #cleanKey > 0 then
                local success, message = ValidateKey(cleanKey, true)
                if success then
                    SaveKeyData(cleanKey)
                    return true, cleanKey
                end
            end
        end
        return false, nil
    end

    local function GetKeyLink()
        return "https://new.pandadevelopment.net/getkey/" .. tostring(serviceName) .. "?hwid=" .. tostring(hwid)
    end

    local function CopyLink()
        fSetClipboard(GetKeyLink())
        onMessage("Key link copied! Open it in your browser.")
    end

    return {
        Verify     = ValidateKey,
        Copy       = CopyLink,
        GetLink    = GetKeyLink,
        CheckSaved = CheckSavedKey
    }
end

