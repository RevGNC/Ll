        local function CloseNotification()
            if isClosing then return end
            isClosing = true

            for i, notif in ipairs(ActiveNotifications) do
                if notif == NotificationFrame then
                    table.remove(ActiveNotifications, i)
                    break
                end
            end

            if NotificationFrame and NotificationFrame.Parent then
                local fadeOutTween = TweenService:Create(NotificationFrame, TweenInfo.new(0.2, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.In), {
                    BackgroundTransparency = 1,
                    Size = SafeUDim2.new(0, 280, 0, 0)
                })
                fadeOutTween:Play()
                fadeOutTween.Completed:Connect(function()
                    NotificationFrame:Destroy()
                end)
                task.delay(0.25, function()
                    if NotificationFrame and NotificationFrame.Parent then
                        NotificationFrame:Destroy()
                    end
                end)
            end
        end

        local task_spawn = (task and task.spawn) or spawn or function(fn) fn() end

        task_spawn(function()
            pcall(function()
                local fadeInTweenInfo = TweenInfo.new(0.2, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.Out)

                TweenService:Create(NotificationFrame, fadeInTweenInfo, {BackgroundTransparency = 0.05}):Play()
                TweenService:Create(TitleLabel, fadeInTweenInfo, {TextTransparency = 0}):Play()
                TweenService:Create(MessageLabel, fadeInTweenInfo, {TextTransparency = 0}):Play()
                TweenService:Create(UserIcon, fadeInTweenInfo, {ImageTransparency = 0}):Play()

                local progressTweenInfo = TweenInfo.new(duration, SafeEnum.EasingStyle.Linear, SafeEnum.EasingDirection.InOut)
                local progressTween = TweenService:Create(ProgressIndicator, progressTweenInfo, {Size = SafeUDim2.new(0, 0, 0, 2)})
                progressTween:Play()

                progressTween.Completed:Connect(function()
                    CloseNotification()
                end)
            end)
        end)

        task_spawn(function()
            pcall(function()
                local waitFunc = task and task.wait or wait
                if waitFunc then
                    waitFunc(duration + 0.5)
                    if NotificationFrame and NotificationFrame.Parent then
                        CloseNotification()
                    end
                end
            end)
        end)

        if CloseButton and CloseButton.MouseButton1Click then
            CloseButton.MouseButton1Click:Connect(CloseNotification)
        end

        return {
            Close = CloseNotification,
            SetTitle = function(newTitle)
                if TitleLabel then TitleLabel.Text = tostring(newTitle or "") end
            end,
            SetMessage = function(newMessage)
                if MessageLabel then MessageLabel.Text = tostring(newMessage or "") end
            end,
            Type = notifType,
            Variant = notifType,
            Frame = NotificationFrame,
        }
    end

    function Window:LockTab(tabName, lockMessage, lockIcon)
        lockMessage = lockMessage or "This tab is locked. because you are not a premium user"
        lockIcon = lockIcon or "rbxassetid://72426107706105"

        for _, tab in pairs(Tabs) do
            if tab.Name == tabName then
                tab.IsLocked = true
                tab.LockMessage = lockMessage
                tab.LockIcon = lockIcon

                if tab.LockIconElement and tab.Icon then
                    tab.Icon.Visible = false
                    tab.LockIconElement.Visible = true

                    tab.LockIconElement.Image = lockIcon
                    tab.LockIconElement.ImageColor3 = tab.Selected and SafeColor3.fromRGB(255, 255, 255) or SafeColor3.fromRGB(180, 180, 185)
                end

                if tab.Selected then
                    for _, otherTab in pairs(Tabs) do
                        if otherTab ~= tab and not otherTab.IsLocked and otherTab.Select then
                            otherTab:Select()
                            break
                        end
                    end
                end

                break
            end
        end
    end

    function Window:UnlockTab(tabName)
        for _, tab in pairs(Tabs) do
            if tab.Name == tabName then
                tab.IsLocked = false

                if tab.LockIconElement and tab.Icon then
                    tab.LockIconElement.Visible = false
                    tab.Icon.Visible = true
                end

                if tab.Select then
                    tab:Select()
                end
                break
            end
        end
    end
end

return { SetupNotify = SetupNotify }

end)

__DEF("GNCHUB.features.config_system", function()
-- File: GNCHUB/features/config_system.lua
--[[
    GNCHUB Modular Library
    Modul  : Config System
    Layer  : 4
    Require: (deps)
    Ekspor : SetupConfigSystem(Window, deps)
--]]

local function SetupConfigSystem(Window, deps)
    local ConfigElements      = Window.ConfigElements
    local ConfigFolder        = Window.ConfigFolder
    local EnsureConfigFolders = Window.EnsureConfigFolders
    local AutoLoadConfigFile  = Window.AutoLoadConfigFile

    function Window:SaveConfig(configName)
        if not writefile or not makefolder or not isfolder then
            if warn then
                warn("File functions not available in this executor")
            end
            self:Notify("Error", "Config system not supported by your executor", 3)
            return false
        end
        
        if not configName or configName == "" then
            self:Notify("Error", "Please provide a config name", 3)
            return false
        end
        
        EnsureConfigFolders()
        
        local configData = {}
        
        for id, element in pairs(ConfigElements) do
            if element.Type == "Toggle" then
                configData[id] = {
                    Type = "Toggle",
                    Value = element.Value
                }
            elseif element.Type == "Textbox" then
                configData[id] = {
                    Type = "Textbox",
                    Value = element.Value
                }
            elseif element.Type == "Dropdown" then
                configData[id] = {
                    Type = "Dropdown",
                    Value = element.Value,
                    Multiple = element.Multiple
                }
            elseif element.Type == "Slider" then
                configData[id] = {
                    Type = "Slider",
                    Value = element.Value
                }
            end
        end
        
        local success, encoded = pcall(function()
            return game:GetService("HttpService"):JSONEncode(configData)
        end)
        
        if not success then
            self:Notify("Error", "Failed to encode config data", 3)
            return false
        end
        
        local fileName = ConfigFolder .. "/" .. configName .. ".json"
        writefile(fileName, encoded)
        self:Notify("Success", "Config '" .. configName .. "' saved!", 3)
        return true
    end

    function Window:LoadConfig(configName)
        if not readfile or not isfile then
            if warn then
                warn("File functions not available in this executor")
            end
            self:Notify("Error", "Config system not supported by your executor", 3)
            return false
        end
        
        if not configName or configName == "" then
            self:Notify("Error", "Please provide a config name", 3)
            return false
        end
        
        local fileName = ConfigFolder .. "/" .. configName .. ".json"
        
        if not isfile(fileName) then
            self:Notify("Error", "Config '" .. configName .. "' not found", 3)
            return false
        end
        
        local success, fileContent = pcall(function()
            return readfile(fileName)
        end)
        
        if not success then
            self:Notify("Error", "Failed to read config file", 3)
            return false
        end
        
        local decoded
        success, decoded = pcall(function()
            return game:GetService("HttpService"):JSONDecode(fileContent)
        end)
        
        if not success then
            self:Notify("Error", "Failed to decode config data", 3)
            return false
        end
        
        for id, data in pairs(decoded) do
            local element = ConfigElements[id]
            if element then
                if data.Type == "Toggle" and element.Type == "Toggle" then
                    if element.Set then
                        element:Set(data.Value, true)
                    end
                elseif data.Type == "Textbox" and element.Type == "Textbox" then
                    if element.Set then
                        element:Set(data.Value, true)
                    end
                elseif data.Type == "Dropdown" and element.Type == "Dropdown" then
                    if element.Set then
                        element:Set(data.Value, true)
                    end
                elseif data.Type == "Slider" and element.Type == "Slider" then
                    if element.Set then
                        element:Set(data.Value, true)
                    end
                end
            end
        end
        
        self:Notify("Success", "Config loaded successfully!", 3)
        return true
    end

    function Window:GetSavedConfigs()
        if not isfolder or not listfiles then
            return {}
        end
        
        if not isfolder(ConfigFolder) then
            return {}
        end
        
        local success, files = pcall(function()
            return listfiles(ConfigFolder)
        end)
        
        if not success then
            return {}
        end
        
        local configs = {}
        for _, file in ipairs(files) do
            local fileName = file:match("([^/\\]+)$")
            if fileName and fileName:match("%.json$") and fileName ~= "autoload.txt" then
                local configName = fileName:gsub("%.json$", "")
                table.insert(configs, configName)
            end
        end
        
        return configs
    end

    function Window:DeleteConfig(configName)
        if not delfile or not isfile then
            self:Notify("Error", "Config system not supported by your executor", 3)
            return false
        end
        
        if not configName or configName == "" then
            self:Notify("Error", "Please provide a config name", 3)
            return false
        end
        
        local fileName = ConfigFolder .. "/" .. configName .. ".json"
        
        if not isfile(fileName) then
            self:Notify("Error", "Config '" .. configName .. "' not found", 3)
            return false
        end
        
        delfile(fileName)
        self:Notify("Success", "Config '" .. configName .. "' deleted!", 3)
        return true
    end

    function Window:SetAutoLoadConfig(configName)
        if not writefile or not makefolder or not isfolder then
            self:Notify("Error", "Config system not supported by your executor", 3)
            return false
        end
        
        if not configName or configName == "" then
            self:Notify("Error", "Please provide a config name", 3)
            return false
        end
        
        local fileName = ConfigFolder .. "/" .. configName .. ".json"
        if not isfile(fileName) then
            self:Notify("Error", "Config '" .. configName .. "' not found", 3)
            return false
        end
        
        EnsureConfigFolders()
        
        writefile(AutoLoadConfigFile, configName)
        self:Notify("Success", "Auto-load set to '" .. configName .. "'", 3)
        return true
    end

    function Window:ResetAutoLoadConfig()
        if not delfile or not isfile then
            self:Notify("Error", "Config system not supported by your executor", 3)
            return false
        end
        
        if isfile(AutoLoadConfigFile) then
            delfile(AutoLoadConfigFile)
        end
        
        self:Notify("Success", "Auto-load config reset!", 3)
        return true
    end

    function Window:GetAutoLoadConfig()
        if not readfile or not isfile then
            return nil
        end
        
        if not isfile(AutoLoadConfigFile) then
            return nil
        end
        
        local success, configName = pcall(function()
            return readfile(AutoLoadConfigFile)
        end)
        
        if success and configName and configName ~= "" then
            return configName
        end
        
        return nil
    end

    function Window:RegisterConfigElement(tabName, sectionName, elementName, element)
        if not element or not element.Type then
            return
        end
        
        local id = tabName .. "." .. sectionName .. "." .. elementName
        ConfigElements[id] = element
    end

    task.spawn(function()
        task.wait(2)
        local autoLoadConfig = Window:GetAutoLoadConfig()
        if autoLoadConfig then
            Window:LoadConfig(autoLoadConfig)
        end
    end)
end

return { SetupConfigSystem = SetupConfigSystem }

end)

__DEF("GNCHUB.components.toggle", function()
-- File: GNCHUB/components/toggle.lua
--[[
    GNCHUB Modular Library
    Modul  : Toggle Component (Reworked - Sleek & Tactile)
    Layer  : 4
    Require: utils/elements, core/config, core/safe_wrappers
    Ekspor : AddToggle(Section, Window, config) -> Toggle
--]]

local function AddToggle(Section, Window, CreateElement, Config, SafeW, TweenService)
    local SafeEnum    = SafeW.SafeEnum
    local SafeUDim2   = SafeW.SafeUDim2
    local SafeUDim    = SafeW.SafeUDim
    local SafeColor3  = SafeW.SafeColor3
    local SafeVector2 = SafeW.SafeVector2

    return function(toggleName, defaultState, callback)
        local config = {}
        if type(toggleName) == "table" then
            config = toggleName
            config.Title = config.Title or config.Name or "Toggle"
            config.Description = config.Description or nil
            config.Default = config.Default or false
            config.Callback = config.Callback or function() end
        else
            if type(defaultState) == "function" then
                callback = defaultState
                defaultState = false
            end
            config.Title = toggleName or "Toggle"
            config.Default = defaultState or false
            config.Callback = callback or function() end
        end

        local Toggle = {
            Value = config.Default,
            Callback = config.Callback,
            Type = "Toggle",
            FirstUpdate = true
        }

        local frameHeight = config.Description and 52 or 40

        local ToggleFrame = CreateElement("Frame", {
            Name = config.Title .. "_Toggle",
            Parent = Section.Container,
            Size = SafeUDim2.new(1, 0, 0, frameHeight),
            BackgroundColor3 = Config.Colors.Primary,
            BorderSizePixel = 0,
            ZIndex = 4,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(0, Config.ControlRadius or 7),
            Parent = ToggleFrame
        })

        local ToggleStroke = CreateElement("UIStroke", {
            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
            Color = Config.Colors.Stroke,
            Thickness = 1,
            Transparency = 0.45,
            Parent = ToggleFrame
        })

        local ContentContainer = CreateElement("Frame", {
            Name = "Content",
            Parent = ToggleFrame,
            Size = SafeUDim2.new(1, -24, 1, 0),
            Position = SafeUDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            ZIndex = 4,
        })

        local ToggleLabel = CreateElement("TextLabel", {
            Name = "Label",
            Parent = ContentContainer,
            Size = config.Description and SafeUDim2.new(1, -56, 0, 18) or SafeUDim2.new(1, -56, 1, 0),
            Position = config.Description and SafeUDim2.new(0, 0, 0, 8) or SafeUDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            Font = SafeEnum.Font.GothamSemibold,
            Text = config.Title,
            TextColor3 = Config.Colors.Text,
            TextSize = 13,
            TextXAlignment = SafeEnum.TextXAlignment.Left,
            TextYAlignment = config.Description and SafeEnum.TextYAlignment.Top or SafeEnum.TextYAlignment.Center,
            TextTruncate = SafeEnum.TextTruncate and SafeEnum.TextTruncate.AtEnd or "AtEnd",
            ZIndex = 5,
        })

        if config.Description then
            CreateElement("TextLabel", {
                Name = "Description",
                Parent = ContentContainer,
                Size = SafeUDim2.new(1, -56, 0, 16),
                Position = SafeUDim2.new(0, 0, 0, 27),
                BackgroundTransparency = 1,
                Font = SafeEnum.Font.Gotham,
                Text = config.Description,
                TextColor3 = Config.Colors.TextSecondary,
                TextSize = 11.5,
                TextXAlignment = SafeEnum.TextXAlignment.Left,
                TextYAlignment = SafeEnum.TextYAlignment.Top,
                TextWrapped = true,
                ZIndex = 5,
            })
        end

        -- Pill Switch Track
        local SwitchTrack = CreateElement("Frame", {
            Name = "SwitchTrack",
            Parent = ContentContainer,
            AnchorPoint = SafeVector2.new(1, 0.5),
            Position = SafeUDim2.new(1, 0, 0.5, 0),
            Size = SafeUDim2.new(0, 40, 0, 22),
            BackgroundColor3 = Config.Colors.Secondary,
            BorderSizePixel = 0,
            ZIndex = 5,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(0, 11),
            Parent = SwitchTrack
        })

        local TrackStroke = CreateElement("UIStroke", {
            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
            Color = Config.Colors.StrokeLight,
            Thickness = 1,
            Transparency = 0.45,
            Parent = SwitchTrack
        })

        -- Sliding Thumb Knob
        local ThumbKnob = CreateElement("Frame", {
            Name = "ThumbKnob",
            Parent = SwitchTrack,
            AnchorPoint = SafeVector2.new(0, 0.5),
            Position = SafeUDim2.new(0, 4, 0.5, 0),
            Size = SafeUDim2.new(0, 14, 0, 14),
            BackgroundColor3 = Config.Colors.TextSecondary,
            BorderSizePixel = 0,
            ZIndex = 6,
        })

        CreateElement("UICorner", {
            CornerRadius = SafeUDim.new(1, 0),
            Parent = ThumbKnob
        })

        local InteractiveButton = CreateElement("TextButton", {
            Name = "InteractiveButton",
            Parent = ToggleFrame,
            Size = SafeUDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 7,
        })

        local tweenFast = TweenInfo.new(0.16, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.Out)
        local hoverTween = TweenInfo.new(0.12, SafeEnum.EasingStyle.Quad, SafeEnum.EasingDirection.Out)

        local function SetToggleState(Value, ignore)
            Toggle.Value = Value

            if Toggle.Value then
                TweenService:Create(SwitchTrack, tweenFast, {
                    BackgroundColor3 = Config.Colors.Accent
                }):Play()
                TweenService:Create(TrackStroke, tweenFast, {
                    Color = Config.Colors.Accent,
                    Transparency = 0.15
                }):Play()
                TweenService:Create(ThumbKnob, tweenFast, {
                    Position = SafeUDim2.new(1, -18, 0.5, 0),
                    BackgroundColor3 = Config.Colors.Text
                }):Play()
            else
                TweenService:Create(SwitchTrack, tweenFast, {
                    BackgroundColor3 = Config.Colors.Secondary
                }):Play()
                TweenService:Create(TrackStroke, tweenFast, {
                    Color = Config.Colors.StrokeLight,
                    Transparency = 0.45
                }):Play()
                TweenService:Create(ThumbKnob, tweenFast, {
                    Position = SafeUDim2.new(0, 4, 0.5, 0),
                    BackgroundColor3 = Config.Colors.TextSecondary
                }):Play()
            end

            if not ignore and (not Toggle.FirstUpdate) then
                task.spawn(function()
                    pcall(Toggle.Callback, Toggle.Value)
                end)
            end
            Toggle.FirstUpdate = false
        end

        function Toggle:Set(valOrIgnore, maybeIgnore)
            if type(self) ~= "table" or self ~= Toggle then
                SetToggleState(self, valOrIgnore)
            else
                SetToggleState(valOrIgnore, maybeIgnore)
            end
        end
        Toggle.SetValue = Toggle.Set

        function Toggle:Get()
            return Toggle.Value
        end
        Toggle.GetValue = Toggle.Get

        InteractiveButton.MouseEnter:Connect(function()
            TweenService:Create(ToggleFrame, hoverTween, {
                BackgroundColor3 = Config.Colors.PrimaryLight
            }):Play()
            TweenService:Create(ToggleStroke, hoverTween, {
                Transparency = 0.2
            }):Play()
        end)

        InteractiveButton.MouseLeave:Connect(function()
            TweenService:Create(ToggleFrame, hoverTween, {
                BackgroundColor3 = Config.Colors.Primary
            }):Play()
            TweenService:Create(ToggleStroke, hoverTween, {
                Transparency = 0.45
            }):Play()
        end)

        InteractiveButton.MouseButton1Click:Connect(function()
            Toggle:Set(not Toggle.Value)
        end)

        Toggle:Set(Toggle.Value, true)

        Window:RegisterConfigElement(Section.TabName, Section.SectionName, config.Title, Toggle)

        return Toggle
    end
end

return { AddToggle = AddToggle }

end)

