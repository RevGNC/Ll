        -- Height calculation & animation (Zero blank dead space, Pixel-Exact)
        local function calculateTargetHeight()
            local visibleCount = 0
            for _, btn in pairs(Dropdown.Buttons) do
                if btn.Visible then
                    visibleCount = visibleCount + 1
                end
            end
            if visibleCount == 0 then
                visibleCount = 1
            end

            local itemHeight = 32
            local itemGap = 4
            local totalCanvasHeight = (visibleCount * itemHeight) + math.max(0, (visibleCount - 1) * itemGap) + 4
            local scrollHeight = math.min(totalCanvasHeight, 150)
            local searchBarHeight = 30
            local multiBarHeight = config.Multiple and 22 or 0
            local padding = 16
            local gaps = config.Multiple and 10 or 5

            local totalWrapperHeight = scrollHeight + searchBarHeight + multiBarHeight + padding + gaps

            return totalWrapperHeight, scrollHeight, totalCanvasHeight
        end

        local function updateDropdownLayout(animated)
            if not Dropdown.Toggled then return end
            local totalHeight, scrollHeight, canvasHeight = calculateTargetHeight()
            dropcont.Size = UDim2.new(1, 0, 0, scrollHeight)
            dropcont.CanvasSize = UDim2.new(0, 0, 0, canvasHeight)

            if animated then
                TweenService:Create(dropcontWrapper, tweenSmooth, {
                    Size = UDim2.new(1, 0, 0, totalHeight)
                }):Play()
            else
                dropcontWrapper.Size = UDim2.new(1, 0, 0, totalHeight)
            end

            task_defer(function()
                if updatePageCanvasSize then updatePageCanvasSize() end
            end)
        end

        local function setDropdownOpen(open)
            if Dropdown.Toggled == open then return end
            Dropdown.Toggled = open

            if open then
                dropcontWrapper.Visible = true
                local totalHeight, scrollHeight, canvasHeight = calculateTargetHeight()
                dropcont.Size = UDim2.new(1, 0, 0, scrollHeight)
                dropcont.CanvasSize = UDim2.new(0, 0, 0, canvasHeight)
                dropcont.CanvasPosition = Vector2.new(0, 0) -- Reset to absolute top origin (0, 0)

                TweenService:Create(TriggerStroke, tweenFast, {
                    Color = Config.Colors.StrokeFocus or Config.Colors.Accent,
