                Color = Config.Colors.Accent,
                Transparency = 0
            }):Play()
            TweenService:Create(SearchIcon, tweenFast, {
                ImageColor3 = Config.Colors.Accent
            }):Play()
        end)

        SearchInput.FocusLost:Connect(function()
            TweenService:Create(SearchStroke, tweenFast, {
                Color = Config.Colors.StrokeLight,
                Transparency = 0.25
            }):Play()
            TweenService:Create(SearchIcon, tweenFast, {
                ImageColor3 = Config.Colors.TextMuted
            }):Play()
        end)

        -- Builder for Option Buttons (Refined & High Contrast)
        local function AddOptions(Options)
            for idx, Option in ipairs(Options) do
                local isSelected = false
                if config.Multiple then
                    isSelected = (type(Dropdown.Value) == "table") and (table.find(Dropdown.Value, Option) ~= nil)
                else
                    isSelected = (Dropdown.Value == Option)
                end

                local dropbtn = CreateElement("TextButton", {
                    Name = "Option_" .. tostring(Option),
                    Font = SafeEnum.Font.Gotham,
                    Text = "",
                    BackgroundColor3 = isSelected and Config.Colors.PrimaryLight or Config.Colors.Surface,
                    BackgroundTransparency = isSelected and 0.2 or 0.6,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, -4, 0, 32),
                    AutoButtonColor = false,
                    LayoutOrder = idx,
                    ZIndex = 12,
                    Parent = dropcont
                })

                CreateElement("UICorner", {
                    CornerRadius = UDim.new(0, 6),
                    Parent = dropbtn
                })

                local btnStroke = CreateElement("UIStroke", {
                    ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
                    Color = Config.Colors.Accent,
                    Thickness = 1,
                    Transparency = isSelected and 0.4 or 1,
                    Parent = dropbtn
                })

                local text_label = CreateElement("TextLabel", {
                    Name = "OptionLabel",
                    Font = isSelected and SafeEnum.Font.GothamBold or SafeEnum.Font.GothamMedium,
                    Text = tostring(Option),
                    TextColor3 = isSelected and Config.Colors.Text or Config.Colors.TextSecondary,
                    TextSize = 13,
                    TextXAlignment = SafeEnum.TextXAlignment.Left,
                    TextYAlignment = SafeEnum.TextYAlignment.Center,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -38, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    ZIndex = 13,
                    Parent = dropbtn
                })

                if config.Multiple then
                    -- Dedicated Checkbox Box with True Lucide Checkmark
                    local checkFrame = CreateElement("Frame", {
                        Name = "CheckFrame",
                        Parent = dropbtn,
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -8, 0.5, 0),
                        Size = UDim2.new(0, 18, 0, 18),
                        BackgroundColor3 = isSelected and Config.Colors.Accent or Config.Colors.Secondary,
                        BorderSizePixel = 0,
                        ZIndex = 13,
                    })

                    CreateElement("UICorner", {
                        CornerRadius = UDim.new(0, 4),
                        Parent = checkFrame
                    })

                    local checkStroke = CreateElement("UIStroke", {
                        ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
                        Color = isSelected and Config.Colors.Accent or Config.Colors.StrokeLight,
                        Thickness = 1,
                        Transparency = 0,
                        Parent = checkFrame
                    })

                    local checkMark = CreateElement("ImageLabel", {
                        Name = "CheckMark",
                        Parent = checkFrame,
                        Image = "rbxassetid://6031094667",
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(0.5, 0, 0.5, 0),
                        Size = UDim2.new(0, 13, 0, 13),
                        BackgroundTransparency = 1,
                        ImageColor3 = SafeColor3.fromRGB(255, 255, 255),
                        ImageTransparency = isSelected and 0 or 1,
                        ZIndex = 14,
                    })
                else
                    -- Single Select: Clean Lucide Checkmark on the right
                    local checkMark = CreateElement("ImageLabel", {
                        Name = "CheckMark",
                        Parent = dropbtn,
                        Image = "rbxassetid://6031094667",
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -10, 0.5, 0),
                        Size = UDim2.new(0, 16, 0, 16),
                        BackgroundTransparency = 1,
                        ImageColor3 = SafeColor3.fromRGB(255, 255, 255),
                        ImageTransparency = isSelected and 0 or 1,
                        ZIndex = 14,
                    })
                end

                dropbtn.MouseEnter:Connect(function()
                    local currentlySelected = false
                    if config.Multiple then
                        currentlySelected = (type(Dropdown.Value) == "table") and (table.find(Dropdown.Value, Option) ~= nil)
                    else
                        currentlySelected = (Dropdown.Value == Option)
                    end

                    if not currentlySelected then
                        TweenService:Create(dropbtn, tweenFast, {
                            BackgroundTransparency = 0.35,
                            BackgroundColor3 = Config.Colors.SecondaryLight
                        }):Play()
                        TweenService:Create(text_label, tweenFast, {
                            TextColor3 = Config.Colors.Text
                        }):Play()
                    end
                end)

                dropbtn.MouseLeave:Connect(function()
                    local currentlySelected = false
                    if config.Multiple then
                        currentlySelected = (type(Dropdown.Value) == "table") and (table.find(Dropdown.Value, Option) ~= nil)
                    else
                        currentlySelected = (Dropdown.Value == Option)
                    end

                    if not currentlySelected then
                        TweenService:Create(dropbtn, tweenFast, {
                            BackgroundTransparency = 1,
                            BackgroundColor3 = Config.Colors.Surface
                        }):Play()
                        TweenService:Create(text_label, tweenFast, {
                            TextColor3 = Config.Colors.TextSecondary
                        }):Play()
                    end
                end)

                dropbtn.MouseButton1Click:Connect(function()
                    if config.Multiple then
                        Dropdown.Value = (type(Dropdown.Value) == "table") and Dropdown.Value or {}
                        local index = table.find(Dropdown.Value, Option)
                        if index then
                            -- Close / Remove this option 1-by-1
                            table.remove(Dropdown.Value, index)
                            Dropdown:Set(Dropdown.Value)
                        else
                            -- Add this option
                            if #Dropdown.Value < config.MaxOptions then
                                table.insert(Dropdown.Value, Option)
                                Dropdown:Set(Dropdown.Value)
                            else
                                if Window and Window.Notify then
                                    Window:Notify("Limit Reached", "Max " .. tostring(config.MaxOptions) .. " options allowed", 2)
                                end
                            end
                        end
                    else
                        if Dropdown.Value == Option then
                            Dropdown:Set("")
                        else
                            Dropdown:Set(Option)
                        end
                        setDropdownOpen(false)
                    end
                end)

                Dropdown.Buttons[Option] = dropbtn
            end
        end

        -- Tag Builder & Visual State Updater ("1 close 1 close" feature)
        local function UpdateVisualState()
            -- Clear existing tag elements safely in reverse order
            local existingChildren = TagContainer:GetChildren()
            for i = #existingChildren, 1, -1 do
                local child = existingChildren[i]
                if child and (child:IsA("Frame") or (child.Name and child.Name:find("^Tag_"))) then
                    pcall(function() child:Destroy() end)
                end
            end

            if config.Multiple then
                local selectedList = (type(Dropdown.Value) == "table") and Dropdown.Value or {}
                local count = #selectedList

                if count == 0 then
                    ValueLabel.Visible = true
                    ValueLabel.Text = config.Placeholder
                    ValueLabel.TextColor3 = Config.Colors.TextMuted
                    ValueLabel.Font = SafeEnum.Font.Gotham
                    TagScroller.Visible = false
                    ClearBtn.Visible = false
                else
                    ValueLabel.Visible = false
                    TagScroller.Visible = true
                    ClearBtn.Visible = true

                    -- Build individual tag pills with 1-by-1 close buttons
                    for tagIdx, optName in ipairs(selectedList) do
                        local tag = CreateElement("Frame", {
                            Name = "Tag_" .. tostring(optName),
                            Parent = TagContainer,
                            Size = UDim2.new(0, 0, 0, 24),
                            AutomaticSize = SafeEnum.AutomaticSize.X,
                            BackgroundColor3 = Config.Colors.Secondary,
                            BorderSizePixel = 0,
                            LayoutOrder = tagIdx,
                            ZIndex = 6,
                        })

                        CreateElement("UICorner", {
                            CornerRadius = UDim.new(0, 6),
                            Parent = tag
                        })

                        CreateElement("UIStroke", {
                            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
                            Color = Config.Colors.StrokeLight,
                            Thickness = 1,
                            Transparency = 0.2,
                            Parent = tag
                        })

                        CreateElement("UIPadding", {
                            PaddingLeft = UDim.new(0, 8),
                            PaddingRight = UDim.new(0, 4),
                            Parent = tag
                        })

                        CreateElement("UIListLayout", {
                            Parent = tag,
                            SortOrder = SafeEnum.SortOrder.LayoutOrder,
                            FillDirection = SafeEnum.FillDirection.Horizontal,
                            VerticalAlignment = SafeEnum.VerticalAlignment.Center,
                            Padding = UDim.new(0, 4)
                        })

                        -- TagText on the LEFT (LayoutOrder = 1)
                        CreateElement("TextLabel", {
                            Name = "TagText",
                            Parent = tag,
                            BackgroundTransparency = 1,
                            Font = SafeEnum.Font.GothamSemibold,
                            Text = tostring(optName),
                            TextColor3 = Config.Colors.Text,
                            TextSize = 11.5,
                            AutomaticSize = SafeEnum.AutomaticSize.X,
                            Size = UDim2.new(0, 0, 1, 0),
                            TextTruncate = SafeEnum.TextTruncate and SafeEnum.TextTruncate.None or "None",
                            LayoutOrder = 1,
                            ZIndex = 7,
                        })

                        -- TagCloseBtn on the RIGHT (LayoutOrder = 2)
                        local tagClose = CreateElement("TextButton", {
                            Name = "TagCloseBtn",
                            Parent = tag,
                            BackgroundTransparency = 1,
                            Size = UDim2.new(0, 16, 0, 16),
                            Text = "×",
                            Font = SafeEnum.Font.GothamBold,
                            TextColor3 = Config.Colors.TextSecondary,
                            TextSize = 14,
                            AutoButtonColor = false,
                            LayoutOrder = 2,
                            ZIndex = 7,
                        })

                        tagClose.MouseEnter:Connect(function()
                            tagClose.TextColor3 = Config.Colors.Error
                        end)
                        tagClose.MouseLeave:Connect(function()
                            tagClose.TextColor3 = Config.Colors.TextSecondary
                        end)

                        tagClose.MouseButton1Click:Connect(function()
                            local curList = (type(Dropdown.Value) == "table") and Dropdown.Value or {}
                            local idx = table.find(curList, optName)
                            if idx then
                                table.remove(curList, idx)
                                Dropdown:Set(curList)
                            end
                        end)
                    end
                end

                if SelectionCounterLabel then
                    local maxText = (config.MaxOptions < math.huge) and (" / " .. tostring(config.MaxOptions)) or ""
                    SelectionCounterLabel.Text = "Selected: " .. tostring(count) .. maxText
                end

                -- Update option button states in popup list
                for optName, btn in pairs(Dropdown.Buttons) do
                    local isSelected = (table.find(selectedList, optName) ~= nil)
                    local label = btn:FindFirstChild("OptionLabel")
                    local checkFrame = btn:FindFirstChild("CheckFrame")
                    local checkMark = checkFrame and checkFrame:FindFirstChild("CheckMark")
                    local btnStroke = btn:FindFirstChild("UIStroke")

                    if label then
                        label.Font = isSelected and SafeEnum.Font.GothamBold or SafeEnum.Font.GothamMedium
                        label.TextColor3 = isSelected and Config.Colors.Text or Config.Colors.TextSecondary
                    end
                    if checkFrame then
                        checkFrame.BackgroundColor3 = isSelected and Config.Colors.Accent or Config.Colors.Secondary
                        local stroke = checkFrame:FindFirstChild("UIStroke")
                        if stroke then
                            stroke.Color = isSelected and Config.Colors.Accent or Config.Colors.StrokeLight
                        end
                    end
                    if checkMark then
                        checkMark.ImageTransparency = isSelected and 0 or 1
                    end
                    if btnStroke then
                        btnStroke.Transparency = isSelected and 0.4 or 1
                    end

                    btn.BackgroundTransparency = isSelected and 0.2 or 0.6
                    btn.BackgroundColor3 = isSelected and Config.Colors.PrimaryLight or Config.Colors.Surface
                end
            else
                TagScroller.Visible = false
                ValueLabel.Visible = true

                local valStr = tostring(Dropdown.Value or "")
                if valStr == "" then
                    ValueLabel.Text = config.Placeholder
                    ValueLabel.TextColor3 = Config.Colors.TextMuted
                    ValueLabel.Font = SafeEnum.Font.Gotham
                    ClearBtn.Visible = false
                else
                    ValueLabel.Text = valStr
                    ValueLabel.TextColor3 = Config.Colors.Text
                    ValueLabel.Font = SafeEnum.Font.GothamBold
                    ClearBtn.Visible = true
                end

                -- Update option button states in popup list
                for optName, btn in pairs(Dropdown.Buttons) do
                    local isSelected = (Dropdown.Value == optName)
                    local label = btn:FindFirstChild("OptionLabel")
                    local check = btn:FindFirstChild("CheckMark")
                    local btnStroke = btn:FindFirstChild("UIStroke")

                    if label then
                        label.Font = isSelected and SafeEnum.Font.GothamBold or SafeEnum.Font.GothamMedium
                        label.TextColor3 = isSelected and Config.Colors.Text or Config.Colors.TextSecondary
                    end
                    if check then
                        check.ImageTransparency = isSelected and 0 or 1
                    end
                    if btnStroke then
                        btnStroke.Transparency = isSelected and 0.4 or 1
                    end

                    btn.BackgroundTransparency = isSelected and 0.2 or 0.6
                    btn.BackgroundColor3 = isSelected and Config.Colors.PrimaryLight or Config.Colors.Surface
                end
            end
        end

        -- Refresh Options Method
        function Dropdown:Refresh(Options, Delete)
            if Delete ~= false then
                for _, v in pairs(Dropdown.Buttons) do
                    pcall(function() v:Destroy() end)
                end
                Dropdown.Buttons = {}
            end
            Dropdown.Options = Options or {}
            AddOptions(Dropdown.Options)
            SearchInput.Text = ""
            SearchOptions()
            UpdateVisualState()
            dropcont.CanvasPosition = Vector2.new(0, 0)
            updateDropdownLayout(false)
        end
        Dropdown.RefreshOptions = Dropdown.Refresh
        Dropdown.SetOptions = Dropdown.Refresh

        -- Set Value Method
        local function SetDropdownVal(Value, ignore)
            if config.Multiple then
                if type(Value) == "table" then
                    local validList = {}
                    for _, v in ipairs(Value) do
                        if #validList < config.MaxOptions and table.find(Dropdown.Options, v) then
                            table.insert(validList, v)
                        end
                    end
                    Dropdown.Value = validList
                else
                    if Value and Value ~= "" and table.find(Dropdown.Options, Value) then
                        Dropdown.Value = { Value }
                    else
                        Dropdown.Value = {}
                    end
                end
            else
                if Value and table.find(Dropdown.Options, Value) then
                    Dropdown.Value = Value
                else
                    Dropdown.Value = ""
                end
            end

            UpdateVisualState()

            if not ignore and config.Callback then
                task.spawn(function()
                    pcall(config.Callback, Dropdown.Value)
                end)
            end
        end

        function Dropdown:Set(valOrIgnore, maybeIgnore)
            if type(self) ~= "table" or self ~= Dropdown then
                SetDropdownVal(self, valOrIgnore)
            else
                SetDropdownVal(valOrIgnore, maybeIgnore)
            end
        end
        Dropdown.SetSelected = Dropdown.Set
        Dropdown.Select = Dropdown.Set

        -- Get Value Method
        function Dropdown:Get()
            return Dropdown.Value
        end
        Dropdown.GetSelected = Dropdown.Get

        function Dropdown:IsSelected(option)
            local opt = (option ~= nil) and option or self
            if config.Multiple then
                if type(Dropdown.Value) == "table" then
                    return table.find(Dropdown.Value, opt) ~= nil
                end
                return false
            else
                return Dropdown.Value == opt
            end
        end

        -- Clear Selection Method
        function Dropdown:Clear()
            SetDropdownVal(config.Multiple and {} or "", false)
        end
        Dropdown.ClearSelection = Dropdown.Clear

        -- Initial Population
        Dropdown:Refresh(Dropdown.Options, false)
        Dropdown:Set(config.Default, true)

        Window:RegisterConfigElement(Section.TabName, Section.SectionName, config.Title, Dropdown)

        return Dropdown
    end
end

return { AddDropdown = AddDropdown }

end)

__DEF("GNCHUB.components.textbox", function()
-- File: GNCHUB/components/textbox.lua
--[[
    GNCHUB Modular Library
    Modul  : Textbox Component (Reworked - Sleek & Quick Clear)
    Layer  : 4
    Require: utils/elements, core/config, core/safe_wrappers
    Ekspor : { AddTextbox, AddInput }
--]]

local SafeW = __REQUIRE("GNCHUB.core.safe_wrappers")
local SafeEnum = SafeW.SafeEnum

local function AddTextbox(Section, Window, CreateElement, Config, TweenService)
    return function(textboxName, placeholder, defaultValue, textDisappear, callback)
        local config = {}
        if type(textboxName) == "table" then
            config = textboxName
            config.Title = config.Title or config.Name or "Input"
            config.Description = config.Description or nil
            config.Placeholder = config.Placeholder or "Enter text..."
            config.Value = config.Value or config.Default or ""
            config.MultiLine = config.MultiLine or false
            config.ClearTextOnFocus = config.ClearTextOnFocus or false
            config.Callback = config.Callback or function() end
        else
            config.Title = textboxName or "Input"
            config.Description = nil
            config.Placeholder = placeholder or "Enter text..."
            config.Value = defaultValue or ""
            config.MultiLine = false
            config.ClearTextOnFocus = textDisappear or false
            config.Callback = callback or function() end
        end

        local Textbox = {
            Value = tostring(config.Value or ""),
            Callback = config.Callback,
            Type = "Textbox"
        }

        local tweenFast = TweenInfo.new(0.18, SafeEnum.EasingStyle.Quart, SafeEnum.EasingDirection.Out)

        local InputFrame = CreateElement("Frame", {
            Name = config.Title .. "_Textbox",
            Parent = Section.Container,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = SafeEnum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            ZIndex = 4,
        })

        CreateElement("UIListLayout", {
            Parent = InputFrame,
            SortOrder = SafeEnum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 5)
        })

        -- Title & Description
        if (config.Title and config.Title ~= "") or (config.Description and config.Description ~= "") then
            local TextHeader = CreateElement("Frame", {
                Name = "TextHeader",
                Parent = InputFrame,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = SafeEnum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = 1,
                ZIndex = 4,
            })

            CreateElement("UIListLayout", {
                Parent = TextHeader,
                SortOrder = SafeEnum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2)
            })

            if config.Title and config.Title ~= "" then
                CreateElement("TextLabel", {
                    Name = "Title",
                    Parent = TextHeader,
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    Font = SafeEnum.Font.GothamSemibold,
                    Text = config.Title,
                    TextColor3 = Config.Colors.Text,
                    TextSize = 13.5,
                    TextXAlignment = SafeEnum.TextXAlignment.Left,
                    TextYAlignment = SafeEnum.TextYAlignment.Center,
                    LayoutOrder = 1,
                    ZIndex = 5,
                })
            end

            if config.Description and config.Description ~= "" then
                CreateElement("TextLabel", {
                    Name = "Description",
                    Parent = TextHeader,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = SafeEnum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Font = SafeEnum.Font.Gotham,
                    Text = config.Description,
                    TextColor3 = Config.Colors.TextSecondary,
                    TextSize = 11.5,
                    TextXAlignment = SafeEnum.TextXAlignment.Left,
                    TextYAlignment = SafeEnum.TextYAlignment.Top,
                    TextWrapped = true,
                    LayoutOrder = 2,
                    ZIndex = 5,
                })
            end
        end

        local inputHeight = config.MultiLine and 74 or 38

        local InputElement = CreateElement("Frame", {
            Name = "InputElement",
            Parent = InputFrame,
            BackgroundColor3 = Config.Colors.Input,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, inputHeight),
            LayoutOrder = 2,
            ZIndex = 4,
        })

        CreateElement("UICorner", {
            CornerRadius = UDim.new(0, Config.ControlRadius or 7),
            Parent = InputElement
        })

        local ElementStroke = CreateElement("UIStroke", {
            ApplyStrokeMode = SafeEnum.ApplyStrokeMode and SafeEnum.ApplyStrokeMode.Border or "Border",
            Color = Config.Colors.Stroke,
            Thickness = 1,
            Transparency = 0.45,
            Parent = InputElement
        })

        local InputBox = CreateElement("TextBox", {
            Name = "TextBox",
            Parent = InputElement,
            Size = UDim2.new(1, -34, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = SafeEnum.Font.Gotham,
            Text = Textbox.Value,
            PlaceholderText = config.Placeholder,
            PlaceholderColor3 = Config.Colors.TextMuted,
            TextColor3 = Config.Colors.Text,
            TextSize = 12.5,
            TextXAlignment = SafeEnum.TextXAlignment.Left,
            TextYAlignment = config.MultiLine and SafeEnum.TextYAlignment.Top or SafeEnum.TextYAlignment.Center,
            TextWrapped = config.MultiLine,
            MultiLine = config.MultiLine,
            ClearTextOnFocus = config.ClearTextOnFocus,
            ClipsDescendants = true,
            ZIndex = 5,
        })

        if config.MultiLine then
            CreateElement("UIPadding", {
                PaddingTop = UDim.new(0, 8),
                PaddingBottom = UDim.new(0, 8),
                Parent = InputBox
            })
        end

        -- Quick Clear Button (`×`)
        local ClearBtn = CreateElement("TextButton", {
            Name = "ClearBtn",
            Parent = InputElement,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.new(0, 18, 0, 18),
            BackgroundTransparency = 1,
            Text = "×",
            Font = SafeEnum.Font.GothamBold,
            TextColor3 = Config.Colors.TextMuted,
            TextSize = 14,
            Visible = (Textbox.Value ~= ""),
            AutoButtonColor = false,
            ZIndex = 6,
        })

        ClearBtn.MouseEnter:Connect(function()
            ClearBtn.TextColor3 = Config.Colors.Error
        end)
        ClearBtn.MouseLeave:Connect(function()
            ClearBtn.TextColor3 = Config.Colors.TextMuted
        end)

        ClearBtn.MouseButton1Click:Connect(function()
            InputBox.Text = ""
            Textbox.Value = ""
            ClearBtn.Visible = false
            task.spawn(function()
                pcall(Textbox.Callback, "")
            end)
        end)

        InputBox:GetPropertyChangedSignal("Text"):Connect(function()
            ClearBtn.Visible = (InputBox.Text ~= "")
        end)

        InputBox.Focused:Connect(function()
            TweenService:Create(InputElement, tweenFast, {
                BackgroundColor3 = Config.Colors.InputFocus or Config.Colors.PrimaryLight
            }):Play()
            TweenService:Create(ElementStroke, tweenFast, {
                Color = Config.Colors.Accent,
                Transparency = 0.1
            }):Play()
        end)

        InputBox.FocusLost:Connect(function(enterPressed)
            TweenService:Create(InputElement, tweenFast, {
                BackgroundColor3 = Config.Colors.Input or Config.Colors.Primary
            }):Play()
            TweenService:Create(ElementStroke, tweenFast, {
                Color = Config.Colors.Stroke,
                Transparency = 0.45
            }):Play()

            Textbox.Value = InputBox.Text
            task.spawn(function()
                pcall(Textbox.Callback, Textbox.Value, enterPressed)
            end)
        end)

        local function SetVal(value, ignore)
            Textbox.Value = tostring(value or "")
            InputBox.Text = Textbox.Value
            ClearBtn.Visible = (Textbox.Value ~= "")
            if not ignore then
                task.spawn(function()
                    pcall(Textbox.Callback, Textbox.Value)
                end)
            end
        end

        function Textbox:Set(valOrIgnore, maybeIgnore)
            if type(self) ~= "table" or self ~= Textbox then
                SetVal(self, valOrIgnore)
            else
                SetVal(valOrIgnore, maybeIgnore)
            end
        end
        Textbox.SetValue = Textbox.Set

        function Textbox:SetPlaceholder(text)
            if type(self) ~= "table" or self ~= Textbox then
                text = self
            end
            InputBox.PlaceholderText = tostring(text or "")
        end

        function Textbox:Get()
            return Textbox.Value
        end
        Textbox.GetValue = Textbox.Get

        Window:RegisterConfigElement(Section.TabName, Section.SectionName, config.Title, Textbox)

        return Textbox
    end
end

local function AddInput(Section, Window, CreateElement, Config, TweenService)
    local addTextboxFn = AddTextbox(Section, Window, CreateElement, Config, TweenService)
    return function(inputName, placeholder, defaultValue, callback)
        return addTextboxFn(inputName, placeholder, defaultValue, false, callback)
    end
end

return { AddTextbox = AddTextbox, AddInput = AddInput }

end)

__DEF("GNCHUB.components.paragraph", function()
-- File: GNCHUB/components/paragraph.lua
--[[
    GNCHUB Modular Library
    Modul  : Paragraph Component (Reworked - Card Surface)
    Layer  : 4
    Require: utils/elements, core/config, core/safe_wrappers
    Ekspor : { AddParagraph, AddTag }
--]]

local SafeW = __REQUIRE("GNCHUB.core.safe_wrappers")
local SafeEnum = SafeW.SafeEnum
local SafeColor3 = SafeW.SafeColor3 or Color3

local function AddParagraph(Section, CreateElement, Config)
    return function(ConfigTable, description)
        if type(ConfigTable) == "string" then
            ConfigTable = {
                Title = ConfigTable,
                Description = description
            }
        else
            ConfigTable = ConfigTable or {}
        end

